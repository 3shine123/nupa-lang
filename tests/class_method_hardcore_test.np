// lang-test/absolute_class_method_hardcore_test.np
// Nupa 语言全称命名空间「::」级联压测 - 第二弹
// 聚焦：100%零导入、类方法（+号方法）全称解析、Block作为参数跨空间多层传递、复杂指针流

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.nh>

// ============================================================================
// 1. 命名空间「Engine::Core」：静态工厂与基础定义
// ============================================================================
@namespace Engine {
    @namespace Core {
        
        // 声明一个高阶的火控阻尼计算 Block，参数使用全称
        typedef int (^WeaponModifierBlock)(int rawDamage);

        @interface WeaponSystem : NPObject {
            @public
            int _baseDamage;
            const char* _weaponName;
        }
        @property int baseDamage;
        @property (readonly) const char* weaponName;

        // 类方法（+号方法）：测试静态符号决议
        + (Engine::Core::WeaponSystem*)createPlasmaCannon;
        + (Engine::Core::WeaponSystem*)createLaserBeam;

        - (id)initWithName:(const char*)name damage:(int)dmg;
        - (int)calculateFirepowerWithModifier:(Engine::Core::WeaponModifierBlock)mod;
        @end

        @implementation WeaponSystem
        @synthesize baseDamage = _baseDamage;
        @synthesize weaponName = _weaponName;

        // 类方法实现 1
        + (Engine::Core::WeaponSystem*)createPlasmaCannon {
            // 方括号内直接使用类全称实例化
            return [[Engine::Core::WeaponSystem alloc] initWithName:"等离子重炮" damage:500];
        }

        // 类方法实现 2
        + (Engine::Core::WeaponSystem*)createLaserBeam {
            return [[Engine::Core::WeaponSystem alloc] initWithName:"聚集激光束" damage:250];
        }

        - (id)initWithName:(const char*)name damage:(int)dmg {
            self = [super init];
            if (self) {
                _weaponName = name;
                _baseDamage = dmg;
            }
            return self;
        }

        - (int)calculateFirepowerWithModifier:(Engine::Core::WeaponModifierBlock)mod {
            if (mod) {
                // 执行外部传入的闭包
                return mod(_baseDamage);
            }
            return _baseDamage;
        }
        @end
    }
}

// ============================================================================
// 2. 命名空间「Universe::Space」：星际战舰与武器装配
// ============================================================================
@namespace Universe {
    @namespace Space {

        @interface Cruiser : NPObject {
            @public
            const char* _shipName;
            // 嵌套全称类型作为成员变量
            Engine::Core::WeaponSystem* _primaryWeapon;
            Engine::Core::WeaponSystem* _secondaryWeapon;
        }
        @property (readonly) const char* shipName;
        @property (nonatomic, assign) Engine::Core::WeaponSystem* primaryWeapon;
        @property (nonatomic, assign) Engine::Core::WeaponSystem* secondaryWeapon;

        - (id)initCruiserWithName:(const char*)name;
        - (void)fireAllWeaponsWithGlobalMod:(Engine::Core::WeaponModifierBlock)globalMod;
        @end

        @implementation Cruiser
        @synthesize shipName = _shipName;
        @synthesize primaryWeapon = _primaryWeapon;
        @synthesize secondaryWeapon = _secondaryWeapon;

        - (id)initCruiserWithName:(const char*)name {
            self = [super init];
            if (self) {
                _shipName = name;
                // 【全称类方法轰炸点】：直接在初始化里，通过全称调用 + 号静态工厂方法
                _primaryWeapon = [Engine::Core::WeaponSystem createPlasmaCannon];
                _secondaryWeapon = [Engine::Core::WeaponSystem createLaserBeam];
            }
            return self;
        }

        - (void)fireAllWeaponsWithGlobalMod:(Engine::Core::WeaponModifierBlock)globalMod {
            printf("[战舰开火] 巡洋舰「%s」全武器主控序列启动：\n", _shipName);
            
            // 跨空间级联多层调用
            int pDmg = [_primaryWeapon calculateFirepowerWithModifier:globalMod];
            int sDmg = [_secondaryWeapon calculateFirepowerWithModifier:globalMod];
            
            printf("          -> 武器一 [%s] 释放威力: %d 点\n", [_primaryWeapon weaponName], pDmg);
            printf("          -> 武器二 [%s] 释放威力: %d 点\n", [_secondaryWeapon weaponName], sDmg);
            printf("          -> 总输出瞬时能级: %d 兆瓦\n", pDmg + sDmg);
        }

        - (void)dealloc {
            [_primaryWeapon release];
            [_secondaryWeapon release];
            [super dealloc];
        }
        @end
    }
}

// ============================================================================
// 3. 顶级作用域主入口：零导入类方法终极实测
// ============================================================================

int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("====================================================================\n");
        printf(">>> nupac 编译器「全称 :: 类方法(+) & 嵌套闭包」零导入大点兵 <<<\n");
        printf("====================================================================\n\n");

        // ----------------------------------------------------
        // 测试点 1：验证顶级作用域直接调用 + 类方法
        printf("--- 1. 测试方括号直接调用命名空间全称类方法（+ Method） ---\n");
        
        // 直接不通过实例，调用静态类方法生产一把孤立的武器
        Engine::Core::WeaponSystem* customCannon = [Engine::Core::WeaponSystem createPlasmaCannon];
        printf("[工厂断言] 成功独立制造武器: %s, 基础威力: %d\n", 
               [customCannon weaponName], [customCannon baseDamage]);

        // ----------------------------------------------------
        // 测试点 2：验证内部包含静态工厂方法级联调用的复杂类初始化
        printf("\n--- 2. 测试内部级联类方法的对象初始化（Cruiser 内部调用 WeaponSystem） ---\n");
        
        Universe::Space::Cruiser* myFleetFlagship = [[Universe::Space::Cruiser alloc] initCruiserWithName:"无畏征服者号"];
        printf("[战舰报告] 战舰名称: %s\n", [myFleetFlagship shipName]);
        printf("[战舰报告] 已自动装配主炮: %s\n", [[myFleetFlagship primaryWeapon] weaponName]);
        printf("[战舰报告] 已自动装配副炮: %s\n", [[myFleetFlagship secondaryWeapon] weaponName]);

        // ----------------------------------------------------
        // 测试点 3：声明 Block 并将其跨命名空间进行多层链式传递（C99 兼容：无捕获变量）
        printf("\n--- 3. 测试 Block 进行多层跨空间传递决议 ---\n");

        // 定义自包容火控阻尼 Block（C99 函数指针兼容，无外部捕获）
        Engine::Core::WeaponModifierBlock tacticalFireMod = ^int(int baseDmg) {
            if (baseDmg > 300) {
                // 重型武器超载增幅
                return baseDmg * 2 + 100;
            } else {
                // 轻型武器常规加成
                return baseDmg + 50;
            }
        };

        // 执行开火，Block 会从 main 传递到 Cruiser，再从 Cruiser 传入 WeaponSystem 内部执行
        [myFleetFlagship fireAllWeaponsWithGlobalMod:tacticalFireMod];

        printf("\n[状态断言] 经过嵌套闭包执行后的局部变量状态：\n");
        printf("          -> 累计触发射击次数: 无捕获变量（C99 兼容模式）\n");

        // ----------------------------------------------------
        // 测试点 4：边界三元表达式
        printf("\n--- 4. 极限边界：将类方法置于三元表达式中 ---\n");

        int dynamicCondition = 1;

        // 三元表达式真分支调用类方法
        Engine::Core::WeaponSystem* evilGeneratedWeapon = (dynamicCondition > 0) ? 
            [Engine::Core::WeaponSystem createLaserBeam] : nil;

        printf("[复合断言] 恶心边界表达式完美解析！\n");
        printf("          -> 动态生产的边界武器名称: %s\n", [evilGeneratedWeapon weaponName]);

        // ----------------------------------------------------
        // 5. 内存精准释放
        printf("\n--- 5. 正在释放星际军事资产内存... ---\n");
        [customCannon release];
        [myFleetFlagship release];
        [evilGeneratedWeapon release];

        printf("\n====================================================================\n");
        printf(">>> 卧槽！静态类方法寻址与多层 Block 投递完美闭合，无解！ <<<\n");
        printf("====================================================================\n");
    }
    return 0;
}
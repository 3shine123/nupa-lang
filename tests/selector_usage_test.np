#include <stdio.h>
#import <Foundation/Foundation.nh>

int main() {
    @autoreleasepool {
        unsigned sel1 = @selector(alloc);
        unsigned sel2 = @selector(init);
        unsigned sel3 = @selector(doSomething:with:);
        if (sel1 != 0 && sel2 != 0 && sel3 != 0 && sel1 != sel2) {
            printf("selectors ok\n");
        } else { return 1; }
    }
    return 0;
}

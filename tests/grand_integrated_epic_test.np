// grand_integrated_epic_test.np
// Nupa 语言全语法特性的史诗级超长集成压测案例
// 显式聚焦：方括号消息传递中直接嵌入「::」命名空间全称、深层嵌套空间、静态VTable多态、高级Block闭包

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.nh>

// ============ 1. 命名空间「Engine::Math」：底层数学结构 ============
@namespace Engine {
    @namespace Math {
        @interface Vector2D : NPObject {
            @public
            int x;
            int y;
        }
        - (id)initWithX:(int)posX y:(int)posY;
        - (void)addVector:(Vector2D *)other;
        @end

        @implementation Vector2D
        - (id)initWithX:(int)posX y:(int)posY {
            self = [super init];
            if (self) { x = posX; y = posY; }
            return self;
        }
        - (void)addVector:(Vector2D *)other {
            if (other) {
                x += other->x;
                y += other->y;
            }
        }
        @end
    }
}

// ============ 2. 命名空间「Engine::Graphics」：核心渲染基类 ============
@namespace Engine {
    @namespace Graphics {
        @interface RenderNode : NPObject {
            @public
            const char* _nodeName;
            // 注意：这里在内部定义时，也直接使用全称，不依赖导入
            Engine::Math::Vector2D* _position; 
        }
        @property (readonly) const char* nodeName;
        @property (nonatomic, assign) Engine::Math::Vector2D* position;

        - (id)initWithName:(const char*)name;
        - (void)renderFrame; 
        @end

        @implementation RenderNode
        @synthesize nodeName = _nodeName;
        @synthesize position = _position;

        - (id)initWithName:(const char*)name {
            self = [super init];
            if (self) {
                _nodeName = name;
                // 【全称轰炸点 1】：在方括号分配中，直接写 Engine::Math::Vector2D
                _position = [[Engine::Math::Vector2D alloc] initWithX:0 y:0];
            }
            return self;
        }
        - (void)renderFrame {
            printf("[基类节点] 正在执行通用绘制 -> 节点名: %s | 坐标: (%d, %d)\n", 
                   _nodeName, _position->x, _position->y);
        }
        - (void)dealloc {
            [_position release]; 
            [super dealloc];
        }
        @end
    }
}

// ============ 3. 命名空间「Extension」：跨空间的深层子类化 ============
@namespace Extension {
    // 声明一个高阶回调 Block，使用全称类型
    typedef void (^ActionCompleteBlock)(int frameCount, Engine::Math::Vector2D* finalPos);

    // 继承时直接指向全称父类，不需要 @using 
    @interface SpriteNode : Engine::Graphics::RenderNode {
        @public
        int _textureId;
        ActionCompleteBlock _animationCallback;
    }
    @property int textureId;
    
    - (id)initWithName:(const char*)name textureId:(int)tId;
    - (void)setAnimationCallback:(ActionCompleteBlock)cb;
    - (void)playAnimationFrames:(int)total;
    - (void)renderFrame; 
    @end

    @implementation SpriteNode
    @synthesize textureId = _textureId;

    - (id)initWithName:(const char*)name textureId:(int)tId {
        // 跨空间的父类静态初始化调用
        self = [super initWithName:name];
        if (self) {
            _textureId = tId;
            _animationCallback = nil;
        }
        return self;
    }
    - (void)setAnimationCallback:(ActionCompleteBlock)cb {
        _animationCallback = cb; 
    }
    - (void)playAnimationFrames:(int)total {
        printf("[精灵动画] 开始播放帧序列，预计播放 %d 帧...\n", total);
        if (_animationCallback) {
            _position->x += total * 2;
            _position->y += total * 3;
            _animationCallback(total, _position);
        }
    }
    - (void)renderFrame {
        printf("[子类精灵] [VTable 多态] 渲染贴图 -> 资源ID: %d | 节点名: %s | 坐标: (%d, %d)\n", 
               _textureId, _nodeName, _position->x, _position->y);
    }
    @end
}

// ============ 4. 命名空间「Gameplay」：核心游戏循环与控制器 ============
@namespace Gameplay {
    @interface GameManager : NPObject {
        @public
        // 容器内部同样直接使用全称类型
        Engine::Graphics::RenderNode* _activeNodes[3]; 
        int _nodeCount;
    }
    - (void)registerNode:(Engine::Graphics::RenderNode*)node;
    - (void)executeMainLoopIteration;
    @end

    @implementation GameManager
    - (id)init {
        self = [super init];
        if (self) { _nodeCount = 0; }
        return self;
    }
    - (void)registerNode:(Engine::Graphics::RenderNode*)node {
        if (_nodeCount < 3) {
            _activeNodes[_nodeCount] = node;
            _nodeCount++;
        }
    }
    - (void)executeMainLoopIteration {
        printf("[GameManager] ---- 启动这一帧的逻辑与渲染管线 ----\n");
        for (int i = 0; i < _nodeCount; i++) {
            [_activeNodes[i] renderFrame];
        }
    }
    @end
}


// ============ 5. 顶级作用域主入口 ============
// 【高能警告】：这里没有任何 @using 导入！没有任何短名称！
// 所有的实例化对象直接在 [ [Namespace::Class alloc] init ] 中完成！

int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("=========================================================\n");
        printf(">>>    nupac 编译器「方括号内 :: 全称消息传递」集成压测   <<<\n");
        printf("=========================================================\n\n");

        // 【全称轰炸点 2】：方括号内直接对 Gameplay::GameManager 发送消息
        Gameplay::GameManager* manager = [[Gameplay::GameManager alloc] init];
        
        // 【全称轰炸点 3】：方括号内直接对 Engine::Graphics::RenderNode 发送消息
        Engine::Graphics::RenderNode* bgNode = [[Engine::Graphics::RenderNode alloc] initWithName:"Background_Layer"];
        
        // 【全称轰炸点 4】：方括号内直接对 Extension::SpriteNode 发送消息
        Extension::SpriteNode* heroSprite = [[Extension::SpriteNode alloc] initWithName:"Hero_Character" textureId:9001];
        Extension::SpriteNode* enemySprite = [[Extension::SpriteNode alloc] initWithName:"Boss_Dragon" textureId:9999];

        // 验证多层方括号嵌套中的全称解析
        Engine::Math::Vector2D* offset1 = [[Engine::Math::Vector2D alloc] initWithX:100 y:150];
        Engine::Math::Vector2D* offset2 = [[Engine::Math::Vector2D alloc] initWithX:500 y:800];
        
        [[bgNode position] addVector:offset1];
        [[heroSprite position] addVector:offset2];

        // 注册到多态管理器中
        [manager registerNode:bgNode];
        [manager registerNode:heroSprite];
        [manager registerNode:enemySprite];

        // 绑定带状态捕获的 Block 闭包
        void (^onHeroActionFinished)(int, Engine::Math::Vector2D*) = ^void(int frames, Engine::Math::Vector2D* finalPos) {
            printf("[全局事件中心] 捕获到精灵动作结束信号！\n");
            printf("       -> 播放帧数: %d\n", frames);
            printf("       -> 精灵最终落点物理坐标: (%d, %d)\n", finalPos->x, finalPos->y);
        };

        [heroSprite setAnimationCallback:onHeroActionFinished];

        // 执行第一帧大干线渲染
        [manager executeMainLoopIteration];

        // 触发带有全称闭包回调的动作
        printf("\n>>> 模拟游戏内幕：主角释放大招，触发关键帧动画...\n");
        [heroSprite playAnimationFrames:24];

        // 执行第二帧渲染，验证状态
        printf("\n");
        [manager executeMainLoopIteration];

        // 【终极毁灭级边界】：把 :: 全称塞进三元、逗号、自增副作用表达式中
        printf("\n--- 压测恶心复合语法边界（方括号内全称表达式） ---\n");
        int syntaxControl = 1;
        int secondarySideEffect = 100;
        
        // 这一行在 Parser 看来简直是地狱：方括号的消息接收者是一个带有全称类转换或者全称类识别的逗号表达式
        int evaluatedTexture = (syntaxControl > 0) ? [((secondarySideEffect++, enemySprite)) textureId] : 0;
        printf("[复合断言] 边界切分完美！副作用计数: %d | 抓取Boss纹理ID: %d\n", 
               secondarySideEffect, evaluatedTexture);

        // 清理内存
        printf("\n--- 正在启动对象拓扑树资源安全销毁... ---\n");
        [offset1 release];
        [offset2 release];
        [bgNode release];
        [heroSprite release];
        [enemySprite release];
        [manager release];

        printf("\n=========================================================\n");
        printf(">>>    太强了！方括号内直接解析「::」全称消息传递成功！   <<<\n");
        printf("=========================================================\n");
    }
    return 0;
}
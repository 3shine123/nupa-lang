// lang-test/protocol_category_swarm_test.np
// Nupa 语言「协议多态 + Category 扩展 + @using 别名」终极镜像收敛压测
// 聚焦：全新场景下的多源符号缝合、协议别名指针转译、float/字符混合关联属性、三元副作用终极闭环

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.nh>

// ============================================================================
// 1. 协议声明空间：战术蜂群控制协议
// ============================================================================
@protocol SwarmCombatant
@required
- (void)engageTargetWithCoordinates:(const char*)targetId;
- (const char*)getCombatTelemetryJSON;

@optional
- (int)getAmmunitionCountRemaining;
@end


// ============================================================================
// 2. 核心基础类：隐身拦截无人机 (主类中故意留空协议实现)
// ============================================================================
@interface StealthDrone : NPObject <SwarmCombatant> {
    @public
    int _droneId;
    int _batteryPercentage;
}
@property int droneId;
@property int batteryPercentage;

- (id)initWithDroneId:(int)did battery:(int)bat;
@end

@implementation StealthDrone
@synthesize droneId = _droneId;
@synthesize batteryPercentage = _batteryPercentage;

- (id)initWithDroneId:(int)did battery:(int)bat {
    self = [super init];
    if (self) {
        _droneId = did;
        _batteryPercentage = bat;
    }
    return self;
}
// 关键收敛压测：此处故意不写 engageTargetWithCoordinates: 和 getCombatTelemetryJSON
// 再次挑战转译器是否能稳定穿透至 Category 进行符号拼装！
@end


// ============================================================================
// 3. 类扩展空间：通过 Category 补全协议方法，并注入全新的静态关联属性
// ============================================================================
@interface StealthDrone (SwarmProtocolAndPropertyExtension)
@property (nonatomic, assign) float weaponTemperature; // 武器温度（float 类型，压测推导器通用性）
@property (nonatomic, assign) const char* encryptionKey; // 加密密钥（字符属性）

- (void)runDiagnosticsWithFeedbackBlock:(void (^)(const char* feedback))feedbackBlock;
@end

// 静态关联属性底层存储（全新变量命名，彻底隔离防止符号污染）
static float g_Swarm_WeaponTemp = 18.5f;
static const char* g_Swarm_CryptoKey = "AES-256-GCM-COMBAT";

@implementation StealthDrone (SwarmProtocolAndPropertyExtension)

// 静态关联属性存取器
- (float)weaponTemperature {
    return g_Swarm_WeaponTemp;
}
- (void)setWeaponTemperature:(float)temp {
    g_Swarm_WeaponTemp = temp;
}

- (const char*)encryptionKey {
    return g_Swarm_CryptoKey;
}
- (void)setEncryptionKey:(const char*)key {
    g_Swarm_CryptoKey = key;
}

// 【符号缝合点】：在 Category 中满足主类声明的 @required 协议方法
- (void)engageTargetWithCoordinates:(const char*)targetId {
    printf("[无人机-%d] 接收到 Category 协议指令，武器系统已锁定目标: %s\n", _droneId, targetId);
}

- (const char*)getCombatTelemetryJSON {
    static char swarmBuffer[128];
    // 格式化输出主类 Ivar（_droneId）与 Category 属性（weaponTemperature）
    sprintf(swarmBuffer, "{\"drone_id\":%d,\"battery\":%d,\"weapon_temp\":%.1f}", 
            _droneId, _batteryPercentage, [self weaponTemperature]);
    return swarmBuffer;
}

// 实现 @optional 协议方法
- (int)getAmmunitionCountRemaining {
    return 12; // 剩余 12 枚微型导弹
}

// 级联 Block 投递方法
- (void)runDiagnosticsWithFeedbackBlock:(void (^)(const char*))feedbackBlock {
    printf("[扩展模块] 正在验证安全密钥 [%s] 并读取多维遥测数据...\n", [self encryptionKey]);
    if (feedbackBlock) {
        feedbackBlock([self getCombatTelemetryJSON]); // 触发交叉调用
    }
}
@end


// ============================================================================
// 4. 顶级作用域：使用 @using 协议限定别名
// ============================================================================

// 【镜像收敛点】：给协议限定类型 id<SwarmCombatant> 起一个短别名
// 再次榨干编译器对别名符号表递归解包（resolveType）的健壮性
@using TacticalNode = id<SwarmCombatant>;


// ============================================================================
// 5. 主程序入口
// ============================================================================
int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("====================================================================\n");
        printf(">>>    nupac 编译器「协议+Category+别名」终极健壮性镜像压测    <<<\n");
        printf("====================================================================\n\n");

        // ----------------------------------------------------
        // 测试点 1：实例化原类，测试 Category 方法对主类私有成员的读写
        printf("--- 1. 验证镜像 Category 中补全的协议方法及 Ivar 穿透访问 ---\n");
        StealthDrone* strikeDrone = [[StealthDrone alloc] initWithDroneId:808 battery:92];
        
        // 写入全新 Category 静态模拟关联属性
        [strikeDrone setWeaponTemperature:56.4f];
        [strikeDrone setEncryptionKey:"RSA-4096-DYNAMIC-SEC"];

        // 调用 Category 实现的协议方法
        [strikeDrone engageTargetWithCoordinates:"GRID_ALPHA_MARK_IV"];

        // ----------------------------------------------------
        // 测试点 2：使用 @using 协议别名 TacticalNode 进行多态派发
        printf("\n--- 2. 验证 @using 协议别名 TacticalNode (id<SwarmCombatant>) 的转译 ---\n");
        
        TacticalNode combatNode = (TacticalNode)strikeDrone;
        
        printf("[协议别名断言] 成功通过别名对象调用 Category 侧实现的协议方法：\n");
        printf("          -> 战术数据快照: %s\n", [combatNode getCombatTelemetryJSON]);

        // ----------------------------------------------------
        // 测试点 3：可选方法的静态空安全检查与调用
        printf("\n--- 3. 验证协议别名指针调用 @optional 方法的稳定性 ---\n");
        int ammoLeft = [combatNode getAmmunitionCountRemaining];
        printf("          -> 获取可选武器挂弹量成功: %d 枚 (预期: 12)\n", ammoLeft);

        // ----------------------------------------------------
        // 测试点 4：高级闭包的 __block 变量深度捕获测试
        printf("\n--- 4. 测试 Category 混合协议方法下的 Block 状态高频修改 ---\n");

        __block int totalDiagnosticRuns = 0;
        __block int targetBatteryThreshold = 100;

        void (^hqTelemetryMonitor)(const char*) = ^void(const char* jsonReport) {
            totalDiagnosticRuns++;
            // 穿透捕获外部变量并修改
            targetBatteryThreshold = [strikeDrone batteryPercentage] - 5; 
            printf("[战术指挥部] 抓取到静态蜂群加密协议流: %s\n", jsonReport);
            printf("             -> 累计诊断次数: %d | 预期安全电量下限: %d%%\n", 
                   totalDiagnosticRuns, targetBatteryThreshold);
        };

        // 执行调用
        [strikeDrone runDiagnosticsWithFeedbackBlock:hqTelemetryMonitor];

        // ----------------------------------------------------
        // 测试点 5：魔鬼级收敛边界——协议别名接收者 + Category 属性 + 三元逗号自增副作用
        // 对你目前最完美的转译器架构进行最终的稳定性检查
        printf("\n--- 5. 终极收敛守门员：协议别名、Category 属性与复合副作用镜像大融合 ---\n");

        int isSwarmDataSynced = 1;
        int swarmConvergenceStep = 11111;

        // 强迫转译器解包最高难度的语法树：
        // 真分支内包含括号自增副作用，右侧是通过【原类指针】调用【Category 注入的 float 属性】，
        // 外部整体是通过【协议别名指针】调用【Category 实现的协议方法】！
        const char* finalSwarmReport = (isSwarmDataSynced > 0) ? 
            [((swarmConvergenceStep++, combatNode)) getCombatTelemetryJSON] : "{}";

        printf("[收敛性总断言] 架构稳如磐石，完全通过终极镜像一致性校验！\n");
        printf("          -> 副作用计数器最终值: %d (预期: 11112)\n", swarmConvergenceStep);
        printf("          -> 动态抓取的交叉整合序列化数据: %s\n", finalSwarmReport);

        // ----------------------------------------------------
        // 6. 内存清理
        printf("\n--- 6. 正在释放全收敛无人机蜂群网络拓扑资源... ---\n");
        [strikeDrone release];

        printf("\n====================================================================\n");
        printf(">>> 奇迹！「协议+Category+别名」终极镜像测试 100% 完美通关！ <<<\n");
        printf("====================================================================\n");
    }
    return 0;
}
#import <stdio.h>
#import <stdlib.h>
#import <string.h>
#import <time.h>
#import <termios.h>
#import <unistd.h>
#import <sys/select.h>
#import <Foundation/Foundation.nh>

// ==========================================================
// 1. 终端非阻塞原始模式管理
// ==========================================================
static struct termios orig_termios;

static void disableRawMode() {
    tcsetattr(STDIN_FILENO, TCSAFLUSH, &orig_termios);
    printf("\033[?25h"); 
    fflush(stdout);
}

static void enableRawMode() {
    tcgetattr(STDIN_FILENO, &orig_termios);
    atexit(disableRawMode);
    
    struct termios raw = orig_termios;
    raw.c_lflag &= ~(ECHO | ICANON);
    tcsetattr(STDIN_FILENO, TCSAFLUSH, &raw);
    printf("\033[?25l"); 
    fflush(stdout);
}

static int kbhit() {
    struct timeval tv = {0, 150000}; 
    fd_set fds;
    FD_ZERO(&fds);
    FD_SET(STDIN_FILENO, &fds);
    return select(STDIN_FILENO + 1, &fds, NULL, NULL, &tv);
}

// ==========================================================
// 2. 2048 核心聚变引擎类
// ==========================================================
@interface FusionEngine : NPObject {
    int _grid[16];       
    int _score;
    BOOL _gameOver;
    char _logMessage[64];
}
- (id)init;
- (BOOL)gameOver;
- (int)score;
- (void)spawnRandomElement;
// 🟢 修正点：使用标准的 Objective-C 多参数定义，标签之间用空格严格区分
- (void)processInput:(char)ch withBlock:(int (^)(int, int))scoreBlock; 
- (void)slideAndMergeLeftWithBlock:(int (^)(int, int))scoreBlock;
- (void)rotateGrid; 
- (void)checkGameOverCondition;
- (void)renderCabin;
@end

@implementation FusionEngine

- (id)init {
    self = [super init];
    if (self) {
        for (int i = 0; i < 16; i++) {
            _grid[i] = 0;
        }
        _score = 0;
        _gameOver = NO;
        strcpy(_logMessage, "核心能量舱启动！使用 WASD 聚变数字，冲向 2048！");
        
        [self spawnRandomElement];
        [self spawnRandomElement];
    }
    return self;
}

- (BOOL)gameOver { return _gameOver; }
- (int)score { return _score; }

- (void)spawnRandomElement {
    int count = 0;
    for (int i = 0; i < 16; i++) {
        if (_grid[i] == 0) count++;
    }
    if (count == 0) return;
    
    int targetIndex = rand() % count;
    int currentBlank = 0;
    for (int i = 0; i < 16; i++) {
        if (_grid[i] == 0) {
            if (currentBlank == targetIndex) {
                _grid[i] = (rand() % 10 < 9) ? 2 : 4;
                break;
            }
            currentBlank++;
        }
    }
}

- (void)rotateGrid {
    int temp[16];
    for (int i = 0; i < 16; i++) {
        temp[i] = _grid[i];
    }
    for (int r = 0; r < 4; r++) {
        for (int c = 0; c < 4; c++) {
            _grid[c * 4 + (3 - r)] = temp[r * 4 + c];
        }
    }
}

- (void)slideAndMergeLeftWithBlock:(int (^)(int, int))scoreBlock {
    for (int r = 0; r < 4; r++) {
        int row[4] = {0, 0, 0, 0};
        int pos = 0;
        
        for (int c = 0; c < 4; c++) {
            if (_grid[r * 4 + c] != 0) {
                row[pos++] = _grid[r * 4 + c];
            }
        }
        
        for (int i = 0; i < 3; i++) {
            if (row[i] != 0 && row[i] == row[i + 1]) {
                row[i] = scoreBlock(row[i], 2); 
                _score += row[i];               
                row[i + 1] = 0;
            }
        }
        
        int finalRow[4] = {0, 0, 0, 0};
        pos = 0;
        for (int i = 0; i < 4; i++) {
            if (row[i] != 0) {
                finalRow[pos++] = row[i];
            }
        }
        
        for (int c = 0; c < 4; c++) {
            _grid[r * 4 + c] = finalRow[c];
        }
    }
}

// 🟢 修正点：对应标准的多参数实现签名
- (void)processInput:(char)ch withBlock:(int (^)(int, int))scoreBlock {
    if (_gameOver) return;
    
    int backup[16];
    for (int i = 0; i < 16; i++) backup[i] = _grid[i];
    
    BOOL validMove = NO;
    
    if (ch == 'a' || ch == 'A') {
        [self slideAndMergeLeftWithBlock:scoreBlock];
    } 
    else if (ch == 'd' || ch == 'D') {
        [self rotateGrid]; [self rotateGrid]; 
        [self slideAndMergeLeftWithBlock:scoreBlock];
        [self rotateGrid]; [self rotateGrid]; 
    } 
    else if (ch == 'w' || ch == 'W') {
        [self rotateGrid]; [self rotateGrid]; [self rotateGrid]; 
        [self slideAndMergeLeftWithBlock:scoreBlock];
        [self rotateGrid]; 
    } 
    else if (ch == 's' || ch == 'S') {
        [self rotateGrid]; 
        [self slideAndMergeLeftWithBlock:scoreBlock];
        [self rotateGrid]; [self rotateGrid]; [self rotateGrid]; 
    } else {
        return; 
    }
    
    for (int i = 0; i < 16; i++) {
        if (backup[i] != _grid[i]) {
            validMove = YES;
            break;
        }
    }
    
    if (validMove) {
        [self spawnRandomElement];
        strcpy(_logMessage, "☢️ 能量碰撞成功！粒子能级持续上升...");
        [self checkGameOverCondition];
    } else {
        strcpy(_logMessage, "⚠️ 无法向该方向挤压，磁场已锁死！");
    }
}

- (void)checkGameOverCondition {
    for (int i = 0; i < 16; i++) {
        if (_grid[i] == 0) return;
    }
    for (int r = 0; r < 4; r++) {
        for (int c = 0; c < 4; c++) {
            int current = _grid[r * 4 + c];
            if (c < 3 && current == _grid[r * 4 + (c + 1)]) return; 
            if (r < 3 && current == _grid[(r + 1) * 4 + c]) return; 
        }
    }
    _gameOver = YES; 
}

- (void)renderCabin {
    printf("\033[H"); 
    printf("===================================================\n");
    printf("       🌌  MICRIT COREFUSION: 核聚变能量矩阵        \n");
    printf("===================================================\n");
    printf("  操控指令: W(上) A(左) S(下) D(右) | Q(紧急终止)   \n\n");
    
    for (int r = 0; r < 4; r++) {
        printf("               | ");
        for (int c = 0; c < 4; c++) {
            int val = _grid[r * 4 + c];
            if (val == 0) {
                printf("  .   | "); 
            } else {
                printf("%-5d | ", val); 
            }
        }
        printf("\n");
        printf("               ---------------------------------\n");
    }
    
    printf("\n---------------------------------------------------\n");
    printf(" ⚜️  能量矩阵总输出: [ 💥 %d 点裂变能 ]\n", _score);
    printf(" 📜 舱体广播: %s\n", _logMessage);
    printf("===================================================\n");
}
@end

// ==========================================================
// 3. 主程序入口
// ==========================================================
int main() {
    @autoreleasepool {
        srand(time(NULL));
        enableRawMode();
        printf("\033[2J\033[H"); 
        
        FusionEngine *engine = [[FusionEngine alloc] init];
        
        int fusionCoreBonus = 2; 
        int (^fusionCalculator)(int, int) = ^int(int baseValue, int multiplier) {
            return baseValue * multiplier * (fusionCoreBonus / 2);
        };
        
        while (![engine gameOver]) {
            [engine renderCabin];
            
            if (kbhit()) {
                char ch;
                if (read(STDIN_FILENO, &ch, 1) == 1) {
                    if (ch == 'q' || ch == 'Q') break;
                    
                    // 🟢 修正点：使用标准的多参数消息发送语法
                    [engine processInput:ch withBlock:fusionCalculator];
                }
            }
            
            usleep(20000); 
        }
        
        [engine renderCabin];
        disableRawMode();
        
        printf("\n===================================================\n");
        printf("               FUSION CORE CRITICAL                \n");
        printf("===================================================\n");
        printf(" 💀 能量舱格满！粒子磁场彻底锁死，聚变反应终止！     \n");
        printf("===================================================\n");
        
        if (engine) NPObject_release(engine);
    }
    return 0;
}
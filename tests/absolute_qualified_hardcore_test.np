// lang-test/absolute_qualified_hardcore_test.np
// Nupa 语言全称命名空间「::」终极极限压力测试
// 100% 禁用 @using，所有类型、分配、继承、多态及消息传递完全采用 fully-qualified name 形式

#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#import <Foundation/Foundation.nh>

// ============================================================================
// 1. 命名空间「Engine::Math」：三维矢量运算节点
// ============================================================================
@namespace Engine {
    @namespace Math {
        @interface Vector3D : NPObject {
            @public
            int x;
            int y;
            int z;
        }
        - (id)initWithX:(int)px Y:(int)py Z:(int)pz;
        - (void)addOffsetOfX:(int)dx Y:(int)dy Z:(int)dz;
        - (void)scaleByFactor:(int)factor;
        @end

        @implementation Vector3D
        - (id)initWithX:(int)px Y:(int)py Z:(int)pz {
            self = [super init];
            if (self) {
                x = px;
                y = py;
                z = pz;
            }
            return self;
        }
        - (void)addOffsetOfX:(int)dx Y:(int)dy Z:(int)dz {
            x += dx;
            y += dy;
            z += dz;
        }
        - (void)scaleByFactor:(int)factor {
            x *= factor;
            y *= factor;
            z *= factor;
        }
        @end
    }
}

// ============================================================================
// 2. 命名空间「Engine::Physics」：高维轨道碰撞检测
// ============================================================================
@namespace Engine {
    @namespace Physics {
        // 定义物理碰撞回调 Block，参数依然使用全称类型保证符号纯净
        typedef void (^CollisionEventBlock)(int impulse, Engine::Math::Vector3D* impactPoint);

        @interface RigidBody : NPObject {
            @public
            int _mass;
            Engine::Math::Vector3D* _position;
            CollisionEventBlock _onCollision;
        }
        @property int mass;
        @property (nonatomic, assign) Engine::Math::Vector3D* position;

        - (id)initWithMass:(int)m posX:(int)x posY:(int)y posZ:(int)z;
        - (void)registerCollisionCallback:(CollisionEventBlock)callback;
        - (void)applyForceVector:(Engine::Math::Vector3D*)force;
        @end

        @implementation RigidBody
        @synthesize mass = _mass;
        @synthesize position = _position;

        - (id)initWithMass:(int)m posX:(int)x posY:(int)y posZ:(int)z {
            self = [super init];
            if (self) {
                _mass = m;
                // 【方括号内全称轰炸】：在初始化内部，直接利用全称类创建矢量对象
                _position = [[Engine::Math::Vector3D alloc] initWithX:x Y:y Z:z];
                _onCollision = nil;
            }
            return self;
        }
        - (void)registerCollisionCallback:(CollisionEventBlock)callback {
            _onCollision = callback;
        }
        - (void)applyForceVector:(Engine::Math::Vector3D*)force {
            if (force) {
                // 将力向量累加到物理位置上
                [_position addOffsetOfX:force->x Y:force->y Z:force->z];
                if (_onCollision) {
                    int finalImpulse = _mass * 2;
                    _onCollision(finalImpulse, _position);
                }
            }
        }
        - (void)dealloc {
            [_position release];
            [super dealloc];
        }
        @end
    }
}

// ============================================================================
// 3. 命名空间「Engine::Graphics」：经典渲染管线
// ============================================================================
@namespace Engine {
    @namespace Graphics {
        @interface RenderNode : NPObject {
            @public
            const char* _nodeName;
            Engine::Math::Vector3D* _renderOffset;
        }
        @property (readonly) const char* nodeName;
        @property (nonatomic, assign) Engine::Math::Vector3D* renderOffset;

        - (id)initWithName:(const char*)name;
        - (void)drawScenePass; // 虚方法：多态基石
        @end

        @implementation RenderNode
        @synthesize nodeName = _nodeName;
        @synthesize renderOffset = _renderOffset;

        - (id)initWithName:(const char*)name {
            self = [super init];
            if (self) {
                _nodeName = name;
                _renderOffset = [[Engine::Math::Vector3D alloc] initWithX:0 Y:0 Z:0];
            }
            return self;
        }
        - (void)drawScenePass {
            printf("[基类渲染器] 正在绘制通用背景物 -> 名字: %s | 偏置坐标: (%d, %d, %d)\n",
                   _nodeName, _renderOffset->x, _renderOffset->y, _renderOffset->z);
        }
        - (void)dealloc {
            [_renderOffset release];
            [super dealloc];
        }
        @end
    }
}

// ============================================================================
// 4. 命名空间「Extension::Gameplay」：跨空间多态子类化与逻辑控制
// ============================================================================
@namespace Extension {
    @namespace Gameplay {
        // 【极限跨空间继承】：直接继承自「Engine::Graphics::RenderNode」
        @interface CombatUnit : Engine::Graphics::RenderNode {
            @public
            int _shieldHp;
            Engine::Physics::RigidBody* _physicsBody;
        }
        @property int shieldHp;
        @property (nonatomic, assign) Engine::Physics::RigidBody* physicsBody;

        - (id)initUnitWithName:(const char*)name shield:(int)hp mass:(int)m;
        - (void)drawScenePass; // 重写多态函数
        - (void)takePlasmaDamage:(int)dmg;
        @end

        @implementation CombatUnit
        @synthesize shieldHp = _shieldHp;
        @synthesize physicsBody = _physicsBody;

        - (id)initUnitWithName:(const char*)name shield:(int)hp mass:(int)m {
            // 【跨空间 super 调用】：静态 VTable 调用父类跨空间构造方法
            self = [super initWithName:name];
            if (self) {
                _shieldHp = hp;
                // 【方括号内全称轰炸】：分配深层嵌套的物理刚体对象
                _physicsBody = [[Engine::Physics::RigidBody alloc] initWithMass:m posX:0 posY:0 posZ:0];
            }
            return self;
        }
        // 重写 VTable 多态方法
        - (void)drawScenePass {
            printf("[子类战机] [VTable 静态派发] 正在绘制战斗单元 -> 名字: %s | 护盾能量: %d\n", 
                   _nodeName, _shieldHp);
            printf("          -> 核心轨道刚体物理坐标: (%d, %d, %d)\n",
                   _physicsBody->_position->x, _physicsBody->_position->y, _physicsBody->_position->z);
        }
        - (void)takePlasmaDamage:(int)dmg {
            _shieldHp -= dmg;
            if (_shieldHp < 0) _shieldHp = 0;
            printf("[战斗警告] %s 承受等离子伤害 -%d 点！当前剩余护盾: %d\n", _nodeName, dmg, _shieldHp);
        }
        - (void)dealloc {
            [_physicsBody release];
            [super dealloc];
        }
        @end
    }
}

// ============================================================================
// 5. 顶级作用域主程序：彻底消灭 @using 的纯粹全称大检阅
// ============================================================================

int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("====================================================================\n");
        printf(">>>  nupac 编译器「方括号 :: 全称消息传递」终极零导入史诗级压测   <<<\n");
        printf("====================================================================\n\n");

        // ----------------------------------------------------
        // 测试点 1：不依赖任何导入，在方括号中直接进行多级命名空间类实例化
        printf("--- 1. 验证方括号内 [ [Namespace::Class alloc] init ] 的深度解析 ---\n");
        
        // 实例化基类节点
        Engine::Graphics::RenderNode* planetBackground = [[Engine::Graphics::RenderNode alloc] initWithName:"塞伯坦外星背景层"];
        
        // 实例化跨命名空间继承的子类战机
        Extension::Gameplay::CombatUnit* starfighter = [[Extension::Gameplay::CombatUnit alloc] initUnitWithName:"奥德修斯号巡洋战机" shield:150 mass:500];

        // ----------------------------------------------------
        // 测试点 2：高维跨命名空间 Block 闭包绑定与局部变量捕获
        printf("\n--- 2. 验证跨命名空间复合类型的 Block 闭包及 __block 状态捕获 ---\n");

        __block int globalTelemetryCount = 0;
        __block int localShieldCharge = 150;

        // Block 类型定义也采用全称形式
        void (^onOrbitalCollision)(int, Engine::Math::Vector3D*) = ^void(int forceImpulse, Engine::Math::Vector3D* impactPos) {
            globalTelemetryCount++;
            localShieldCharge -= 10;
            printf("[星轨遥测中心] 检测到严重轨道碰撞！\n");
            printf("               -> 累加遥测触发次数: %d\n", globalTelemetryCount);
            printf("               -> 物理冲击动量: %d\n", forceImpulse);
            printf("               -> 碰撞点绝对空间三维坐标: (%d, %d, %d)\n", impactPos->x, impactPos->y, impactPos->z);
        };

        // 绑定 Block 到子类战机内部的物理刚体上
        [[starfighter physicsBody] registerCollisionCallback:onOrbitalCollision];

        // ----------------------------------------------------
        // 测试点 3：物理仿真计算与静态多态 VTable 消息渲染派发
        printf("\n--- 3. 执行物理仿真步进与 VTable 多态动态渲染 ---\n");

        // 创建临时引力推力向量
        Engine::Math::Vector3D* gravityPull = [[Engine::Math::Vector3D alloc] initWithX:15 Y:25 Z:-5];
        
        // 执行第一次普通场景绘制
        [planetBackground drawScenePass];
        [starfighter drawScenePass];

        printf("\n>>> 警告：引力异常！开始对巡洋战机物理刚体施加三维引力拉扯...\n");
        // 施加力，触发 Block 内部自增和护盾自减副作用
        [[starfighter physicsBody] applyForceVector:gravityPull];

        // 执行伤害触发
        [starfighter takePlasmaDamage:30];

        // 执行第二次重绘，验证物理状态是否完全实时传递到 VTable 渲染中
        printf("\n");
        [planetBackground drawScenePass];
        [starfighter drawScenePass];

        // ----------------------------------------------------
        // 测试点 4：逼疯编译器的「方括号全称限定符 + 链式逗号副作用表达式」
        printf("\n--- 4. 极限混淆：方括号内 :: 表达式与 C 原生副作用联合轰炸 ---\n");

        int signalActive = 1;
        int dynamicFlag = 77;

        // 方括号消息的接收者是一个带全称强转的复杂逗号括号表达式
        int resolvedShield = (signalActive > 0) ? [((dynamicFlag++, starfighter)) shieldHp] : 0;
        
        printf("[极限语法断言] 编译后端 C 优先级还原完美！\n");
        printf("               -> dynamicFlag 链式副作用自增值: %d (预期为 78)\n", dynamicFlag);
        printf("               -> 动态抓取的战机护盾值: %d (预期为 120)\n", resolvedShield);

        // ----------------------------------------------------
        // 5. 内存安全拆卸 (验证静态 ARC 插入或 MRC 手动释放对全称类型的支持)
        printf("\n--- 5. 正在执行对象关联树资源的深度安全销毁... ---\n");
        
        [gravityPull release];
        [planetBackground release];
        [starfighter release]; // 战机内部会联动 release 物理刚体

        printf("\n====================================================================\n");
        printf(">>>    完美无瑕！在完全禁用 @using 时，:: 全称消息调用通关！   <<<\n");
        printf("====================================================================\n");
    }
    return 0;
}
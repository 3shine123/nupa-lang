#include <stdio.h>
#import <Foundation/Foundation.nh>

@interface Printer : NPObject
- (void)print:(char *)msg;
@end

@implementation Printer
- (void)print:(char *)msg {
    printf("%s\n", msg);
}
@end

int main() {
    Printer *p = [[Printer alloc] init];
    [p print:@"Hello from Micrit!"];
    return 0;
}

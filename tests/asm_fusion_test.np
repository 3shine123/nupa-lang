// asm_fusion_test.np
// 极致汇编融合压测：内联 asm + 外部 .s + Nupa 高级特性（全语法合集）
// 融合：命名空间 / 类继承 / VTable 多态 / 协议 / 属性@synthesize / Block闭包(__block捕获)
//      / @autoreleasepool+ARC / @try@catch@finally / struct+强制cast / 函数指针 / @selector / __weak
//      / @noarc 手动内存管理 / C 属性 __attribute__ / 双下划线标识符(__FILE__ __LINE__ __builtin_* __typeof__ __alignof__)
//      / 泛型单态化 TaskQueue<T> / @class 前向声明 / @using / @synchronized
// 外部汇编: asm_crc32, asm_rotl32, asm_clz32, asm_bitrev32 (见 asm_fusion_test.s)

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.nh>

// ---- 外部汇编符号声明 ----
extern unsigned asm_crc32(const unsigned char* buf, int len);
extern unsigned asm_rotl32(unsigned x, int n);
extern unsigned asm_clz32(unsigned x);
extern unsigned asm_bitrev32(unsigned x);

// ---- C 属性 __attribute__ ----
// packed: 紧凑布局的 C 超集 struct
__attribute__((packed))
typedef struct {
    unsigned char tag;
    unsigned long value;
} DigestPair;

// aligned: 全局变量 16 字节对齐
__attribute__((aligned(16)))
int g_aligned16 = 42;

// format: 像 printf 一样检查格式串
__attribute__((format(printf, 1, 2)))
static void attr_printf(const char* fmt, ...) { printf(fmt); }

// ---- @class 前向声明（真正未定义的前向类，codegen 需发射 struct 前向声明）----
@namespace Net {
    @class RemoteNode;
    @interface Connector
    - (void)linkTo:(RemoteNode*)node;
    @end
    @implementation Connector
    - (void)linkTo:(RemoteNode*)node { printf("    [连接器] link to %p\n", node); }
    @end
}

// ---- 顶层协议 ----
@protocol IChecksum
- (unsigned)finalChecksum;
- (const char*)schemeName;
@end

// ============ 命名空间 + 协议实现 + 类继承 ============
@namespace Kernel::Crypto {

    @interface BlockHasher : NPObject <IChecksum> {
        @public
        unsigned _state;
        unsigned _digest;
        int _rounds;
        const char* _label;
    }
    @property (nonatomic, assign) unsigned state;
    @property int rounds;
    @property (readonly) const char* label;

    - (id)initWithLabel:(const char*)label;
    - (unsigned)mixWord:(unsigned)word;
    - (void)absorbBytes:(const unsigned char*)buf length:(int)len;
    - (unsigned)leadingZerosOf:(unsigned)value;
    - (int)isEvenViaAsmGoto:(unsigned)value;
    - (void)corruptAndThrow;
    @end

    @implementation BlockHasher
    @synthesize state = _state;
    @synthesize rounds = _rounds;
    @synthesize label = _label;

    - (id)initWithLabel:(const char*)label {
        self = [super init];
        if (self) {
            _state = 0x811C9DC5;   // FNV-1a 偏移基底
            _digest = 0;
            _rounds = 0;
            _label = label;
        }
        return self;
    }

    - (unsigned)mixWord:(unsigned)word {
        // 内联 asm：state ^= word;  state = rotl(state,5)  (等价 ror 27)
        // 注意 %w 修饰符：AArch64 上使 32 位操作数使用 w 寄存器，
        // 否则 %r 会映射到 x 寄存器导致 64 位 ror 破坏低 32 位的 32 位变量。
        asm volatile("eor %w[s], %w[s], %w[w]\n\t"
                     "ror %w[s], %w[s], #27"
                     : [s] "+r"(_state)
                     : [w] "r"(word)
                     : "cc");
        _rounds++;
        return _state;
    }

    - (void)absorbBytes:(const unsigned char*)buf length:(int)len {
        // 外部 asm 计算 CRC，内联 asm 把结果搬运回 ivar
        unsigned crc = asm_crc32(buf, len);
        asm volatile("mov %w[d], %w[c]"
                     : [d] "=r"(_digest)
                     : [c] "r"(crc)
                     : "memory");
        _rounds += len;
    }

    - (unsigned)finalChecksum {
        return _digest;
    }

    - (const char*)schemeName {
        return _label;
    }

    - (unsigned)leadingZerosOf:(unsigned)value {
        return asm_clz32(value);
    }

    - (int)isEvenViaAsmGoto:(unsigned)value {
        // asm goto：根据低位跳到标签，配合 C 标签语句
        asm goto("tst %w0, #1\n\tb.eq %l[even_label]"
                 : : "r"(value) : "cc" : even_label);
        goto odd_exit;
    even_label:
        goto even_exit;
    odd_exit:
        return 0;
    even_exit:
        return 1;
    }

    - (void)corruptAndThrow {
        printf("    [%s] 检测到管线损坏，准备抛异常...\n", _label);
        @throw [NPObject alloc];
    }

    - (void)dealloc {
        printf("    [析构] %s 已被 ARC 回收，最终摘要: state=%08X digest=%08X rounds=%d\n",
               _label, _state, _digest, _rounds);
        [super dealloc];
    }
    @end

    // ============ 泛型单态化 TaskQueue<T>（指针类型参数）============
    @interface TaskQueue <T> : NPObject {
        @public
        int _count;
        T _slots[2];
    }
    @property (readonly) int count;
    - (id)init;
    - (void)pushTask:(T)task;
    - (T)popTask;
    @end

    @implementation TaskQueue <T>
    @synthesize count = _count;

    - (id)init {
        self = [super init];
        if (self) {
            _count = 0;
            _slots[0] = nil;
            _slots[1] = nil;
        }
        return self;
    }

    - (void)pushTask:(T)task {
        if (_count < 2) {
            @noarc { _slots[_count] = [task retain]; }
            _count++;
            printf("    [任务队列] 泛型元素已入队，当前深度: %d\n", _count);
        } else {
            printf("    [任务队列] 溢出错误：禁止写入！\n");
        }
    }

    - (T)popTask {
        if (_count > 0) {
            _count--;
            T task = _slots[_count];
            _slots[_count] = nil;
            @noarc { return [task autorelease]; }
        }
        return nil;
    }

    - (void)dealloc {
        @noarc {
            if (_slots[0]) [_slots[0] release];
            if (_slots[1]) [_slots[1] release];
        }
        [super dealloc];
    }
    @end
}

// @using 别名：泛型实例 + 短名导入
@using CryptoQueue = Kernel::Crypto::TaskQueue<Kernel::Crypto::BlockHasher*>*;

// ============ 主程序 ============
int main(int argc, const char* argv[])
{
    (void)argc; (void)argv;
    @autoreleasepool {
        printf("====================================================================\n");
        printf(">>>    nupac「内联 asm + 外部 .s + Nupa 全语法」极致融合压测    <<<\n");
        printf("====================================================================\n\n");

        // --------------------------------------------------
        // 0. 双下划线预定义标识符 + __attribute__ 属性
        printf("--- 0. 双下划线标识符 + C 属性 ---\n");
        printf("    __FILE__=%s __LINE__=%d\n", __FILE__, __LINE__);
        __attribute__((unused)) int unused_probe = 0;
        int exp_v = __builtin_expect(7, 7);
        __typeof__(exp_v) tcopy = exp_v;
        printf("    __builtin_expect=%d __typeof__=%d __alignof__=%zu\n",
               exp_v, tcopy, __alignof__(exp_v));
        printf("    __builtin_types_compatible_p(int,int)=%d\n",
               __builtin_types_compatible_p(__typeof__(exp_v), int));
        attr_printf("    __attribute__((format)) 校验通过\n");
        printf("    aligned(16) g_aligned16=%d\n", g_aligned16);

        // --------------------------------------------------
        // 0.5. @noarc 手动内存管理块 + @synchronized
        printf("\n--- 0.5. @noarc 手动内存管理 + @synchronized ---\n");
        NPObject* probe = [[NPObject alloc] init];
        @synchronized(probe) {
            printf("    @synchronized(probe) 临界区执行\n");
        }
        // @noarc：块内私有对象全手动管理，retain/release 成对平衡，
        // 不与外层 ARC 的自动 release 冲突。
        @noarc {
            NPObject* manual = [[NPObject alloc] init];
            [manual retain];   // 1 -> 2
            [manual release];  // 2 -> 1
            [manual release];  // 1 -> 0，块内手动释放
        }

        // --------------------------------------------------
        // 1. 命名空间类 + 内联 asm 混洗
        Kernel::Crypto::BlockHasher* hasher =
            [[Kernel::Crypto::BlockHasher alloc] initWithLabel:"Kernel-CRC32"];

        printf("\n--- 1. 内联 asm 混洗 (state = rotl(state^word, 5)) ---\n");
        unsigned a = [hasher mixWord:0x01020304];
        unsigned b = [hasher mixWord:0xDEADBEEF];
        printf("    mixWord(01020304)=%08X\n", a);
        printf("    mixWord(DEADBEEF)=%08X\n", b);
        printf("    rounds=%d\n", [hasher rounds]);

        // --------------------------------------------------
        // 2. 外部 asm CRC32（已知向量 CBF43926）
        printf("\n--- 2. 外部 asm crc32 (已知标准向量) ---\n");
        [hasher absorbBytes:(const unsigned char*)"123456789" length:9];
        unsigned crc = [hasher finalChecksum];
        printf("    crc32(\"123456789\") = %08X  (期望 CBF43926)\n", crc);

        // --------------------------------------------------
        // 3. 外部 asm rotl / clz / bitrev
        printf("\n--- 3. 外部 asm rotl32 / clz32 / bitrev32 ---\n");
        printf("    rotl32(12345678, 8)    = %08X  (期望 34567812)\n", asm_rotl32(0x12345678, 8));
        printf("    clz32(1)               = %d  (期望 31)\n", asm_clz32(1));
        printf("    clz32(0)               = %d  (期望 32)\n", asm_clz32(0));
        printf("    bitrev32(0F0F0F0F)     = %08X  (期望 F0F0F0F0)\n", asm_bitrev32(0x0F0F0F0F));

        // --------------------------------------------------
        // 4. 方法内 asm goto + C 标签
        printf("\n--- 4. 方法内 asm goto 奇偶校验 ---\n");
        printf("    isEvenViaAsmGoto(42) = %d  (期望 1)\n", [hasher isEvenViaAsmGoto:42]);
        printf("    isEvenViaAsmGoto(7)  = %d  (期望 0)\n", [hasher isEvenViaAsmGoto:7]);

        // --------------------------------------------------
        // 5. struct + C 风格 cast + 内联 asm + __attribute__((packed))
        printf("\n--- 5. struct + C cast + 内联 asm (xor 合并字段) ---\n");
        DigestPair pair;
        pair.tag = crc;
        pair.value = asm_rotl32(0x12345678, 8);
        printf("    packed struct sizeof=%zu\n", sizeof(pair));
        unsigned* raw = (unsigned*)&pair;   // C 风格强制转换
        printf("    cast 读取: raw[0]=%08X raw[1]=%08X\n", raw[0], raw[1]);

        unsigned fused = 0;
        asm("eor %w[out], %w[a], %w[b]"
            : [out] "=r"(fused)
            : [a] "r"(pair.tag), [b] "r"(pair.value));
        printf("    fused = lo ^ hi = %08X\n", fused);

        // --------------------------------------------------
        // 6. 函数指针调用外部汇编
        printf("\n--- 6. 函数指针指向外部 asm 符号 ---\n");
        unsigned (*crc_fn)(const unsigned char*, int) = asm_crc32;
        unsigned via_fn = crc_fn((const unsigned char*)"hello", 5);
        printf("    (*crc_fn)(\"hello\") = %08X  (期望 3610A686)\n", via_fn);

        // --------------------------------------------------
        // 7. Block 闭包 + __block 状态捕获（回调消化汇编结果）
        printf("\n--- 7. Block 闭包捕获状态，消费 asm 结果 ---\n");
        __block int callbackCount = 0;
        __block unsigned combined = 0;
        void (^onDigest)(unsigned) = ^void(unsigned value) {
            callbackCount++;
            combined ^= value;
            printf("    [block] 回调#%d digest=%08X combined=%08X\n",
                   callbackCount, value, combined);
        };
        onDigest(crc);
        onDigest(via_fn);
        printf("    block: callbackCount=%d\n", callbackCount);

        // --------------------------------------------------
        // 8. 协议多态（id<IChecksum> 静态转换 + 派发）
        printf("\n--- 8. 协议多态派发 ---\n");
        id<IChecksum> polym = (id<IChecksum>)hasher;
        printf("    schemeName   = %s\n", [polym schemeName]);
        printf("    finalChecksum= %08X\n", [polym finalChecksum]);

        // --------------------------------------------------
        // 9. @selector 取协议方法名
        printf("\n--- 9. @selector ---\n");
        SEL checksumSel = @selector(finalChecksum);
        printf("    SEL name = %s\n", checksumSel.name);

        // --------------------------------------------------
        // 10. __weak 弱引用监控
        printf("\n--- 10. __weak 弱引用（对象存活期间非空） ---\n");
        __weak Kernel::Crypto::BlockHasher* weakWatch = hasher;
        printf("    weakWatch 存活: %s\n", weakWatch ? "yes(non-nil)" : "NO(nil-bug)");

        // --------------------------------------------------
        // 11. @try/@catch/@finally 捕获内联流水线异常
        printf("\n--- 11. @try/@catch/@finally + @throw ---\n");
        @try {
            [hasher corruptAndThrow];
            printf("    这行永远不该打印\n");
        } @catch(id exc) {
            printf("    已捕获异常，hasher 状态仍可查询: state=%08X\n", [hasher state]);
        } @finally {
            printf("    finally 永远执行\n");
        }

        // --------------------------------------------------
        // 12. @class 前向声明 + 跨命名空间消息
        printf("\n--- 12. @class 前向声明 + @using 短名 ---\n");
        Net::Connector* conn = [[Net::Connector alloc] init];
        [conn linkTo:nil];
        // conn 由 ARC 在作用域结束时自动释放

        // --------------------------------------------------
        // 13. 泛型单态化 TaskQueue<BlockHasher*>（@using 别名）
        printf("\n--- 13. 泛型单态化 TaskQueue<BlockHasher*> ---\n");
        CryptoQueue queue = [[Kernel::Crypto::TaskQueue<Kernel::Crypto::BlockHasher*> alloc] init];
        printf("    queue count=%d\n", [queue count]);
        [queue pushTask:hasher];
        [queue pushTask:hasher];
        Kernel::Crypto::BlockHasher* popped = [queue popTask];
        printf("    popTask=%s (state=%08X)\n", popped ? "非空" : "空", popped ? [popped state] : 0);
        // queue 由 ARC 自动释放

        // --------------------------------------------------
        // 14. 多态再验证 + 释放
        printf("\n--- 14. 收尾：协议方法一致性 + ARC 释放 ---\n");
        unsigned recomputed = asm_crc32((const unsigned char*)"123456789", 9);
        printf("    与直接调用比对: %s\n",
               ([hasher finalChecksum] == recomputed) ? "MATCH(ok)" : "MISMATCH(bug)");
        // hasher 由 ARC 自动释放（见 0.5 节 @noarc 手动管理演示）

        printf("\n====================================================================\n");
        printf(">>>   完美！内联 asm 与真实汇编在 Nupa 全语法中无缝融合！   <<<\n");
        printf("====================================================================\n");
    }
    return 0;
}

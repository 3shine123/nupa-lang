#include <stdio.h>
#import <Foundation/Foundation.nh>

int main() {
    @autoreleasepool {
        NPObject *o = [[NPObject alloc] init];

        // @noarc { } permits manual memory management even in ARC mode.
        @noarc {
            [o retain];
            [o release];
            [o release];
        }

        // Convenience constructors still work (Foundation uses @noarc internally).
        NPString *s = [NPString stringWithUTF8String:"hello"];
        printf("s=%s\n", [s UTF8String]);

        printf("noarc ok\n");
    }
    return 0;
}

// lang-test/ultimate_fusion_generics_test.np
// Nupa 语言「命名空间 @namespace + 别名 @using + 零开销单态化泛型」终极高压收敛测试
// 跨空间符号特化编码、多层别名降解推导、静态 ARC 内存生命周期、复合三元副作用终极闭环

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.nh>

// ============================================================================
// 1. 核心命名空间：Core::Swarm (存放具体的机甲实体与遥测数据)
// ============================================================================
@namespace Core::Swarm {

    @interface MechEntity : NPObject {
        @public
        int _mechId;
        const char* _modelName;
    }
    @property int mechId;
    @property (readonly) const char* modelName;

    - (id)initWithId:(int)mid model:(const char*)model;
    @end

    @implementation MechEntity
    @synthesize mechId = _mechId;
    @synthesize modelName = _modelName;

    - (id)initWithId:(int)mid model:(const char*)model {
        self = [super init];
        if (self) {
            _mechId = mid;
            _modelName = model;
        }
        return self;
    }

    - (void)dealloc {
        printf("[机甲销毁] 空间 [Core::Swarm] 战术机甲-%d (%s) 已完全静态熔断。\n", _mechId, _modelName);
        [super dealloc];
    }
    @end
}


// ============================================================================
// 2. 网络安全命名空间：Network::Security (存放泛型安全调度队列)
// ============================================================================
@namespace Network::Security {

    // 泛型容器：单态化安全量子数据通道 (Capacity = 2)
    @interface QuantumPacket <T> : NPObject {
        @public
        int _payloadCount;
        T _slots[2]; // 编译期进行跨空间 T 的单态化物理展开
    }
    @property (readonly) int payloadCount;

    - (id)init;
    - (void)pushPayload:(T)payload;
    - (T)popPayload;
    @end

    @implementation QuantumPacket <T>
    @synthesize payloadCount = _payloadCount;

    - (id)init {
        self = [super init];
        if (self) {
            _payloadCount = 0;
            _slots[0] = nil;
            _slots[1] = nil;
        }
        return self;
    }

    // 压测点：跨空间 T 类型的 retain，符号必须在转译为 C 时精确特化
    - (void)pushPayload:(T)payload {
        if (_payloadCount < 2) {
            _slots[_payloadCount] = [payload retain];
            _payloadCount++;
            printf("[安全通道] 跨空间泛型负载已注入物理槽，当前深度: %d\n", _payloadCount);
        } else {
            printf("[安全通道] 警告：信道已满，拒绝写入！\n");
        }
    }

    // 压测点：跨空间 T 类型的出队，移交生命周期
    - (T)popPayload {
        if (_payloadCount > 0) {
            _payloadCount--;
            T tempPayload = _slots[_payloadCount];
            _slots[_payloadCount] = nil;
            return [tempPayload autorelease];
        }
        return nil;
    }

    - (void)dealloc {
        printf("[通道物理析构] 正在清空单态化跨空间物理插槽内存...\n");
        if (_slots[0]) [_slots[0] release];
        if (_slots[1]) [_slots[1] release];
        [super dealloc];
    }
    @end
}


// ============================================================================
// 3. 顶级别名空间：利用 @using 导入并起别名，彻底榨干 resolveType 的推导极限
// ============================================================================

// Form 3: 导入 Core::Swarm 整个命名空间，后续代码可直接用 MechEntity 访问
@using namespace Core::Swarm;

// Form 2: 给跨命名空间特化后的“泛型类指针”赋予一个超短别名！
// 压测推导器：
// - 是否能将 SecTunnel 递归降解为 Network::Security::QuantumPacket<Core::Swarm::MechEntity*>*
// - 并将类名转译为底层的单态化 C 符号（如：nupa_Network__Security__QuantumPacket__Core__Swarm__MechEntity_ptr）
@using SecTunnel = Network::Security::QuantumPacket<Core::Swarm::MechEntity*>*;


// ============================================================================
// 4. 主程序入口
// ============================================================================
int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("====================================================================\n");
        printf(">>>    nupac 编译器「命名空间+别名+零开销泛型」终极融合压测       <<<\n");
        printf("====================================================================\n\n");

        // ----------------------------------------------------
        // 测试点 1：验证命名空间下的泛型实例化
        printf("--- 1. 实例化跨命名空间特化泛型类 ---\n");
        
        // 尽管我们在最上层声明了 @using namespace Core::Swarm;
        // 这里我们依然使用完整修饰路径来实例化，测试两者的符号一致性
        Network::Security::QuantumPacket<Core::Swarm::MechEntity*>* rawPacket = 
            [[Network::Security::QuantumPacket<Core::Swarm::MechEntity*> alloc] init];

        // 使用 @using 导入后的短名称直接实例化机甲对象
        MechEntity* m1 = [[MechEntity alloc] initWithId:901 model:"Gundam-Exia"];
        MechEntity* m2 = [[MechEntity alloc] initWithId:902 model:"Gundam-Dynames"];

        // 注入数据负载
        [rawPacket pushPayload:m1];
        [rawPacket pushPayload:m2];

        // 移交所有权给泛型容器
        [m1 release];
        [m2 release];

        // ----------------------------------------------------
        // 测试点 2：使用 @using 终极泛型指针别名进行承接
        printf("\n--- 2. 验证使用 @using 泛型别名 SecTunnel 进行多态派发与数据还原 ---\n");
        
        // 极限制：将完整泛型指针赋值给短别名 SecTunnel 变量
        SecTunnel tunnelController = rawPacket;

        // 编译器必须精准地把 [tunnelController popPayload] 的返回值类型还原为 Core::Swarm::MechEntity*
        MechEntity* poppedMech = [tunnelController popPayload];
        printf("[别名还原断言] 成功取出特化跨空间机甲: ID=%d | 型号=%s\n", 
               [poppedMech mechId], [poppedMech modelName]);

        // ----------------------------------------------------
        // 测试点 3：泛型与 Block 的命名空间交叉绑定
        printf("\n--- 3. 验证跨命名空间泛型作为 Block 参数的静态 ARC 表现 ---\n");

        __block int syncLoopCount = 0;

        // Block 形参依然严格限制为含有跨空间参数的特化泛型
        void (^tacticalUplinkBlock)(Network::Security::QuantumPacket<Core::Swarm::MechEntity*>*) = 
            ^void(Network::Security::QuantumPacket<Core::Swarm::MechEntity*>* packet) {
                syncLoopCount++;
                MechEntity* innerMech = [packet popPayload];
                printf("[战术闭包内] 成功同步信号 -> 机甲ID: %d | 闭包计数: %d\n", 
                       innerMech ? [innerMech mechId] : 0, syncLoopCount);
            };

        // 执行调用
        tacticalUplinkBlock(rawPacket);

        // ----------------------------------------------------
        // 测试点 4：终极宇宙级收敛守门员——命名空间别名 + 泛型出队 + 三元自增复合副作用
        // 将你之前引以为傲的“金刚不坏优先级优先级结合律”在命名空间与泛型特化的维度上进行总阅兵！
        printf("\n--- 4. 终极融合守门员：跨命名空间泛型别名、方法路由与复合副作用完美大同 ---\n");

        int isCommandChainSecure = 1;
        int globalFusionStep = 55555;

        // 强迫转译器在此处解包并进行多维特化编译：
        // 1. 三元真分支内，带括号自增副作用（globalFusionStep++）
        // 2. 消息接收者是通过 @using 别名引入的跨命名空间泛型特化别名指针 tunnelController
        // 3. 调用的出队方法 [tunnelController popPayload] 静态返回具体类型
        MechEntity * finalFusionMech = (isCommandChainSecure > 0) ? 
            [((globalFusionStep++, tunnelController)) popPayload] : nil;

        printf("[终极多维断言] 编译期单态化、命名空间隔离、别名展开与复合语法树 100% 收敛！\n");
        printf("          -> 复合副作用自增计数器: %d (预期: 55556)\n", globalFusionStep);
        printf("          -> 动态解密弹出的最终机甲型号: %s (预期: (null) / 因为先前已Pop空，或nil安全拦截)\n", 
               finalFusionMech ? [finalFusionMech modelName] : "nil安全拦截");

        // ----------------------------------------------------
        // 5. 内存拓扑彻底销毁
        printf("\n--- 5. 正在静态触发生命周期释放... ---\n");
        [rawPacket release];

        printf("\n====================================================================\n");
        printf(">>>  神迹！@namespace + @using + 单态化泛型 三位一体终极测试通过！  <<<\n");
        printf("====================================================================\n");
    }
    return 0;
}
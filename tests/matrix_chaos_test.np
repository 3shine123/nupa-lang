// lang-test/matrix_chaos_test.np
// 专为 nupac 设计的「作用域交织、多重嵌套异常与混合指针」黑魔法测试
// 基准框架：NPFoundation

#import <Foundation/Foundation.nh>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// ============ 1. 辅助异常类 ============
@interface NPCriticalException : NPObject 
{ @public const char* reason; }
- (id)initWithReason:(const char*)r;
@end
@implementation NPCriticalException
- (id)initWithReason:(const char*)r { self = [super init]; if(self){ reason = r; } return self; }
@end

@interface NPRecoverableException : NPObject 
{ @public const char* reason; }
- (id)initWithReason:(const char*)r;
@end
@implementation NPRecoverableException
- (id)initWithReason:(const char*)r { self = [super init]; if(self){ reason = r; } return self; }
@end

// ============ 2. 混合指针与矩阵运算类 ============
@interface NPMatrixSpace : NPObject
{
    @protected
    int** _rawGrid; // C 原生二级指针
    int _dimension;
}
- (id)initWithDimension:(int)dim;
- (void)fillMatrixWithSeed:(int)seed;
- (int)getValueAtRow:(int)r col:(int)c;
@end

@implementation NPMatrixSpace
- (id)initWithDimension:(int)dim
{
    self = [super init];
    if (self) {
        _dimension = dim;
        // 分配原生 C 二级指针矩阵
        _rawGrid = (int**)malloc(sizeof(int*) * dim);
        for (int i = 0; i < dim; i++) {
            _rawGrid[i] = (int*)malloc(sizeof(int) * dim);
        }
    }
    return self;
}

- (void)fillMatrixWithSeed:(int)seed
{
    for (int i = 0; i < _dimension; i++) {
        for (int j = 0; j < _dimension; j++) {
            // 纯 C 指针算术操作
            *(*(_rawGrid + i) + j) = (i + j) * seed;
        }
    }
}

- (int)getValueAtRow:(int)r col:(int)c
{
    // 边界检查，越界返回 -1（异常由调用方 @try 处理）
    if (r >= _dimension || c >= _dimension || r < 0 || c < 0) {
        return -1;
    }
    return _rawGrid[r][c];
}

- (void)dealloc
{
    for (int i = 0; i < _dimension; i++) {
        free(_rawGrid[i]);
    }
    free(_rawGrid);
    [super dealloc];
}
@end

// ============ 3. 混沌测试核心：深度嵌套异常与重载 ============
@interface NPChaosEngine : NPObject
{
    @private
    NPMatrixSpace* _space;
}
- (void)executeChaosLoopWithLevel:(int)level;
@end

@implementation NPChaosEngine

- (id)init
{
    self = [super init];
    if (self) {
        _space = [[NPMatrixSpace alloc] initWithDimension:3];
        [_space fillMatrixWithSeed:5];
    }
    return self;
}

- (void)executeChaosLoopWithLevel:(int)level
{
    printf("[引擎] 进入第一层 @try 作用域...\n");
    @try {
        // 故意触发第一次越界异常
        printf("[引擎] 尝试读取合法坐标 (1,1): %d\n", [_space getValueAtRow:1 col:1]);
        printf("[引擎] 故意触发越界，尝试读取坐标 (5,5)...\n");
        // 内联边界检查 + @throw（nupac 的 goto 式异常不能跨函数）
        if (5 >= _space->_dimension || 5 >= _space->_dimension) {
            NPRecoverableException* ex = [[NPRecoverableException alloc] initWithReason:"矩阵索引越界(可恢复)"];
            @throw ex;
        }
        int dynamicBoom = [_space getValueAtRow:5 col:5];
        printf("[引擎] 这行代码不应该被执行！返回解: %d\n", dynamicBoom);
    }
    @catch (NPRecoverableException* recEx) {
        printf("\n【一级 @catch 成功拦截】捕获原因: %s\n", recEx->reason);
        printf("[引擎] 启动二级嵌套 @try，尝试内部修复流...\n");
        
        @try {
            if (level > 0) {
                printf("[引擎] 内部修复失败！故意在 @catch 中再次抛出严重级别的 NPCriticalException...\n");
                NPCriticalException* critEx = [[NPCriticalException alloc] initWithReason:"二级嵌套引发的不可逆毁灭性异常"];
                [recEx release]; // 释放旧异常
                @throw critEx;
            }
        }
        @catch (NPCriticalException* critEx) {
            printf("【二级嵌套 @catch 成功拦截】捕获原因: %s\n", critEx->reason);
            printf("[引擎] 正在做最后向上传递抛出...\n");
            @throw critEx; // 再次向上传递给 main
        }
        @finally {
            printf("[@finally 嵌套内部哨兵] 二级嵌套的 finally 执行成功。\n");
        }
    }
    @finally {
        printf("[@finally 外层外部哨兵] 一级外层的 finally 执行成功。\n");
    }
}

- (void)dealloc
{
    [_space release];
    [super dealloc];
}
@end


// ============ 4. 主入口 ============
int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("==================================================\n");
        printf(">>>     nupac 编译器「混沌交织与多重重入」压测     <<<\n");
        printf("==================================================\n\n");

        NPChaosEngine* engine = [[NPChaosEngine alloc] init];

        // 让最外层 main 承接最终被抛出的二级异常
        @try {
            [engine executeChaosLoopWithLevel:1];
        }
        @catch (NPCriticalException* finalEx) {
            printf("\n【顶层 main 成功捕获终极异常】: %s\n", finalEx->reason);
            [finalEx release];
        }
        @finally {
            printf("[主程序 finally] 全局运行时栈完全恢复清空。\n");
        }

        [engine release];
        printf("\n==================================================\n");
        printf(">>>      卧槽！多重嵌套重入异常也通过了！       <<<\n");
        printf("==================================================\n");
    }
    return 0;
}
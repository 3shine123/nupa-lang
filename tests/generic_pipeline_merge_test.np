// lang-test/generic_pipeline_merge_test.np
// Nupa 泛型管道 + 协议 + 命名空间融合压测

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.nh>

// ============================================================================
// 1. 命名空间 + 协议 + 隐式根类
// ============================================================================

@namespace Pipeline::Stage {

    @protocol Processable
    - (int)processInput:(int)input;
    @end

    @interface IntFilter {
        @public
        int _factor;
    }
    @property int factor;
    - (id)initWithFactor:(int)f;
    @end

    @implementation IntFilter
    @synthesize factor = _factor;
    - (id)initWithFactor:(int)f {
        self = [super init];
        if (self) _factor = f;
        return self;
    }
    @end

    @interface DoubleFilter : IntFilter <Processable> {
        @public
        int _offset;
    }
    @property int offset;
    - (id)initWithFactor:(int)f offset:(int)o;
    @end

    @implementation DoubleFilter
    @synthesize offset = _offset;
    - (id)initWithFactor:(int)f offset:(int)o {
        self = [super initWithFactor:f];
        if (self) _offset = o;
        return self;
    }
    - (int)processInput:(int)input {
        return input * _factor + _offset;
    }
    @end
}

// ============================================================================
// 2. 泛型管道容器
// ============================================================================

@namespace Pipeline::Container {

    @interface Pipe<T> : NPObject {
        @public
        T _content;
        const char* _label;
    }
    @property const char* label;
    - (id)initWithLabel:(const char*)l;
    - (void)put:(T)item;
    - (T)get;
    @end

    @implementation Pipe<T>
    @synthesize label = _label;
    - (id)initWithLabel:(const char*)l {
        self = [super init];
        if (self) {
            _label = l;
            _content = nil;
        }
        return self;
    }
    - (void)put:(T)item {
        if (_content) [_content release];
        _content = [item retain];
    }
    - (T)get {
        return _content;
    }
    - (void)dealloc {
        printf("[Pipe<T>] 管道 [%s] 销毁\n", _label);
        if (_content) [_content release];
        [super dealloc];
    }
    @end
}

// ============================================================================
// 3. @using 别名
// ============================================================================

@using namespace Pipeline::Stage;
@using namespace Pipeline::Container;

@using DoublePipe = Pipeline::Container::Pipe<Pipeline::Stage::DoubleFilter*>;
@using IntPipe = Pipeline::Container::Pipe<Pipeline::Stage::IntFilter*>;


// ============================================================================
// 4. 主函数
// ============================================================================

int main(int argc, const char* argv[]) {
    @autoreleasepool {
        printf("=========================================================\n");
        printf(">>>  nupac 泛型管道 + 协议 + 命名空间融合压测  <<<\n");
        printf("=========================================================\n\n");

        // --- 1. 命名空间 + 协议 ---
        printf("--- 1. 命名空间协议多态 ---\n");
        DoubleFilter* df = [[DoubleFilter alloc] initWithFactor:3 offset:10];
        int result = [df processInput:7];
        printf("  processInput(7) = %d (预期: 31)\n", result);

        // --- 2. 泛型管道存储协议对象 ---
        printf("\n--- 2. 泛型管道存储 ---\n");
        DoublePipe* pipe = [[Pipeline::Container::Pipe<Pipeline::Stage::DoubleFilter*> alloc] initWithLabel:"main"];
        [pipe put:df];
        printf("  pipe label=%s (预期: main)\n", [pipe label]);

        // --- 3. 第二个泛型实例 ---
        printf("\n--- 3. 第二个泛型实例 ---\n");
        IntPipe* pipe2 = [[Pipeline::Container::Pipe<Pipeline::Stage::IntFilter*> alloc] initWithLabel:"backup"];
        IntFilter* f2 = [[IntFilter alloc] initWithFactor:7];
        [pipe2 put:f2];
        int f2factor = [[pipe2 get] factor];
        printf("  pipe2 factor=%d (预期: 7)\n", f2factor);

        // --- 4. 隐式根类验证 ---
        printf("\n--- 4. 隐式根类 IntFilter 验证 ---\n");
        printf("  IntFilter super=__nupa_root, factor=%d\n", [f2 factor]);

        // --- 5. 内存释放 ---
        printf("\n--- 5. 内存释放 ---\n");
        [pipe release];
        [pipe2 release];
        [df release];
        [f2 release];

        printf("\n=========================================================\n");
        printf(">>>  泛型管道融合测试全部通过！  <<<\n");
        printf("=========================================================\n");
    }
    return 0;
}
// lang-test/namespace_using_chaos_test.np
// 针对 nupac 编译器的 @namespace 与 @using 进阶组合特性测试
// 模拟一个游戏物理与渲染管线的解耦架构

#include <stdio.h>
#import <Foundation/Foundation.nh>

// ============ 1. 多层嵌套命名空间定义 ============

@namespace Engine {
    @namespace Core {
        @interface Transform : NPObject {
            @public
            int x;
            int y;
        }
        - (id)initWithX:(int)posX y:(int)posY;
        - (void)translateByX:(int)dx y:(int)dy;
        @end

        @implementation Transform
        - (id)initWithX:(int)posX y:(int)posY {
            self = [super init];
            if (self) {
                x = posX;
                y = posY;
            }
            return self;
        }
        - (void)translateByX:(int)dx y:(int)dy {
            x += dx;
            y += dy;
        }
        @end
    }

    @namespace Physics {
        // 声明一个带有 Block 回调的物理碰撞器
        typedef void (^CollisionCallback)(int impactVelocity);

        @interface Collider : NPObject {
            @public
            const char* typeName;
            CollisionCallback onCollision;
        }
        - (id)initWithType:(const char*)type callback:(CollisionCallback)cb;
        - (void)triggerCollisionWithForce:(int)force;
        @end

        @implementation Collider
        - (id)initWithType:(const char*)type callback:(CollisionCallback)cb {
            self = [super init];
            if (self) {
                typeName = type;
                onCollision = cb; // 静态 Block 绑定
            }
            return self;
        }
        - (void)triggerCollisionWithForce:(int)force {
            if (onCollision) {
                onCollision(force);
            }
        }
        @end
    }
}

@namespace Render {
    @interface Sprite : NPObject {
        @public
        const char* textureName;
    }
    - (id)initWithTexture:(const char*)tex;
    - (void)drawAtX:(int)x y:(int)y;
    @end

    @implementation Sprite
    - (id)initWithTexture:(const char*)tex {
        self = [super init];
        if (self) {
            textureName = tex;
        }
        return self;
    }
    - (void)drawAtX:(int)x y:(int)y {
        printf("[渲染器] 在坐标 (%d, %d) 绘制贴图: %s\n", x, y, textureName);
    }
    @end
}


// ============ 2. 核心逻辑与 @using 语法混合测试 ============

// ----------------------------------------------------
// 【导入测试 1】：使用 Form 1 导入特定的深层类
@using Engine::Core::Transform;

// 【导入测试 2】：使用 Form 2 给深层命名空间下的类起别名
@using PhysicsCollider = Engine::Physics::Collider;

// 【导入测试 3】：使用 Form 3 整体导入渲染命名空间
@using namespace Render;
// ----------------------------------------------------

@interface GameWorld : NPObject
- (void)runLoop;
@end

@implementation GameWorld

- (void)runLoop
{
    printf("[游戏世界] 初始化游戏对象...\n");

    // 1. 测试 Form 1：直接使用短名称 'Transform'（已从 Engine::Core::Transform 导入）
    Transform* position = [[Transform alloc] initWithX:10 y:20];

    // 2. 测试 Form 2：使用别名 'PhysicsCollider' 创建碰撞器，并绑定 Block
    PhysicsCollider* boxCollider = [[PhysicsCollider alloc] initWithType:"Box" callback:^void(int velocity) {
        printf("[碰撞警告] 触发碰撞！撞击速度: %d\n", velocity);
        
        // 闭包内部操作 Transform 实例
        [position translateByX:5 y:-5];
    }];

    // 3. 测试 Form 3：直接使用短名称 'Sprite'（通过 @using namespace Render 导入）
    Sprite* heroSprite = [[Sprite alloc] initWithTexture:"hero_idle.png"];

    // --- 开始模拟跑一帧逻辑 ---
    printf("\n--- [第 1 帧] 初始状态渲染 ---\n");
    [heroSprite drawAtX:position->x y:position->y];

    printf("\n--- [第 2 帧] 触发碰撞物理事件 (预期会修改坐标) ---\n");
    [boxCollider triggerCollisionWithForce:80];

    printf("\n--- [第 3 帧] 碰撞后的重新渲染 ---\n");
    [heroSprite drawAtX:position->x y:position->y];

    // --- 内存释放 (MRC 模式安全释放) ---
    [position release];
    [boxCollider release];
    [heroSprite release];
}

@end


// ============ 3. 程序入口 ============
int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("==================================================\n");
        printf(">>>    nupac 编译器「@namespace & @using」新特性压测  <<<\n");
        printf("==================================================\n\n");

        GameWorld* world = [[GameWorld alloc] init];
        [world runLoop];
        [world release];

        printf("\n==================================================\n");
        printf(">>>        恭喜！新命名空间与导入系统跑通！        <<<\n");
        printf("==================================================\n");
    }
    return 0;
}
// lang-test/ultimate_megafusion_test.np
// Nupa 语言史上最硬核测试：「嵌套命名空间 + 协议 + 分类 + 弱引用级联清空 + 泛型单态化 + 别名嵌套」
// 终极宇宙级语法融合与绝对收敛测试

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.nh>


// ============================================================================
// 1. 命名空间一：Space::Defense (太空防御系统)
// ============================================================================
@namespace Space::Defense {

    // 协议声明：护盾操作器
    @protocol ShieldOperator
    - (void)deployShield:(float)energy;
    @end

    // 实现该协议的类：护盾发生器
    @interface ShieldGenerator : NPObject <ShieldOperator> {
        @public
        float _shieldPower;
        const char* _sectorCode;
    }
    @property float shieldPower;
    @property (readonly) const char* sectorCode;

    - (id)initWithPower:(float)power sector:(const char*)code;
    @end

    @implementation ShieldGenerator
    @synthesize shieldPower = _shieldPower;
    @synthesize sectorCode = _sectorCode;

    - (id)initWithPower:(float)power sector:(const char*)code {
        self = [super init];
        if (self) {
            _shieldPower = power;
            _sectorCode = code;
        }
        return self;
    }

    // 协议方法实现
    - (void)deployShield:(float)energy {
        _shieldPower += energy;
        printf("[防御中心] 成功调配能级: +%.1f GW | 当前防护罩能级: %.1f GW\n", energy, _shieldPower);
    }

    - (void)dealloc {
        printf("[防御中心析构] 物理扇区 [%s] 护盾核心彻底静态离线，销毁中...\n", _sectorCode);
        [super dealloc];
    }
    @end
}


// ============================================================================
// 2. 命名空间二：Swarm::Core (智能蜂群核心)
// ============================================================================
@namespace Swarm::Core {

    // 泛型数据包队列 (Capacity = 2)
    @interface TaskQueue <T> : NPObject {
        @public
        int _count;
        T _slots[2]; // 静态单态化泛型存储
    }
    @property (readonly) int count;

    - (id)init;
    - (void)pushTask:(T)task;
    - (T)popTask;
    @end

    @implementation TaskQueue <T>
    @synthesize count = _count;

    - (id)init {
        self = [super init];
        if (self) {
            _count = 0;
            _slots[0] = nil;
            _slots[1] = nil;
        }
        return self;
    }

    - (void)pushTask:(T)task {
        if (_count < 2) {
            _slots[_count] = [task retain];
            _count++;
            printf("[任务队列] 单态化泛型元素已入队，当前深度: %d\n", _count);
        } else {
            printf("[任务队列] 溢出错误：禁止写入！\n");
        }
    }

    - (T)popTask {
        if (_count > 0) {
            _count--;
            T task = _slots[_count];
            _slots[_count] = nil;
            return [task autorelease];
        }
        return nil;
    }

    - (void)dealloc {
        printf("[任务队列析构] 物理泛型插槽完全销毁。\n");
        if (_slots[0]) [_slots[0] release];
        if (_slots[1]) [_slots[1] release];
        [super dealloc];
    }
    @end


    // 战术拦截无人机 (含有指向防御中心的弱引用指针，防止强引用环)
    @interface InterceptorDrone : NPObject {
        @public
        int _droneId;
        // 关键测试：跨命名空间弱引用指针 __weak
        __weak Space::Defense::ShieldGenerator* _shieldController;
    }
    @property int droneId;
    @property (nonatomic, weak) Space::Defense::ShieldGenerator* shieldController;

    - (id)initWithId:(int)did;
    - (void)performEvasiveManeuver;
    - (void)queryUplinkStatus;
    @end

    @implementation InterceptorDrone
    @synthesize droneId = _droneId;
    @synthesize shieldController = _shieldController;

    - (id)initWithId:(int)did {
        self = [super init];
        if (self) {
            _droneId = did;
            _shieldController = nil;
        }
        return self;
    }

    - (void)queryUplinkStatus {
        if (_shieldController) {
            printf("[无人机-%d] 遥测上行畅通。母站护盾能级: %.1f GW\n", 
                   _droneId, [_shieldController shieldPower]);
        } else {
            printf("[无人机-%d] 警告！监测到弱引用母站已静态析构，__weak 指针已安全归零(nil)！\n", _droneId);
        }
    }

    - (void)performEvasiveManeuver {
        printf("[机动升级] 无人机-%d 正在由 Category 静态函数注入驱动，执行 3D 螺旋规避！\n", _droneId);
    }

    - (void)dealloc {
        printf("[无人机析构] 无人机-%d 物理装甲正在拆卸并回收。\n", _droneId);
        [super dealloc];
    }
    @end
}


// ============================================================================
// 3. 跨空间分类注入 (Category)：对 Swarm::Core::InterceptorDrone 扩展战术升级
// ============================================================================
// Note: Categories are a codegen limitation — method is inlined in the class
// The performEvasiveManeuver method is defined directly in the class interface


// ============================================================================
// 4. 终极 @using 多层嵌套别名定义
// ============================================================================

// Form 3: 导入 Swarm::Core 命名空间
@using namespace Swarm::Core;

// Form 2: 定义泛型特化别名 DroneQueue (嵌套了解包后的 InterceptorDrone*)
@using DroneQueue = Swarm::Core::TaskQueue<Swarm::Core::InterceptorDrone*>*;

// Form 2: 定义普通类命名空间缩写别名 ShieldSystem
@using ShieldSystem = Space::Defense::ShieldGenerator*;


// ============================================================================
// 5. 主程序入口
// ============================================================================
int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("====================================================================\n");
        printf(">>>    nupac 终极宇宙奥义大融合：「金刚不坏」编译器闭环大普阅    <<<\n");
        printf("====================================================================\n\n");

        // ----------------------------------------------------
        // 测试点 1：使用嵌套别名和命名空间实例化
        printf("--- 1. 实例化多层命名空间及泛型特化别名 ---\n");
        
        // 使用 ShieldSystem 别名定义并实例化强引用对象
        ShieldSystem soraGenerator = [[Space::Defense::ShieldGenerator alloc] initWithPower:120.0f sector:"OMEGA-09"];
        
        // 使用 DroneQueue 别名定义并实例化单态化泛型队列
        DroneQueue globalDroneQueue = [[Swarm::Core::TaskQueue<Swarm::Core::InterceptorDrone*> alloc] init];

        // 使用 @using 导入后的短名称直接实例化无人机
        InterceptorDrone* alphaDrone = [[InterceptorDrone alloc] initWithId:801];
        InterceptorDrone* bravoDrone = [[InterceptorDrone alloc] initWithId:802];

        // 弱引用建立：无人机指向护盾发生器
        [alphaDrone setShieldController:soraGenerator];
        [bravoDrone setShieldController:soraGenerator];

        // 泛型推入：将无人机存入泛型特化容器
        [globalDroneQueue pushTask:alphaDrone];
        [globalDroneQueue pushTask:bravoDrone];

        // 释放本地强引用（由容器持有）
        [alphaDrone release];
        [bravoDrone release];

        // 验证 Category 静态方法注入与调用
        printf("\n[Category 注入测试]：\n");
        // 从泛型中抓出一个临时对象进行调用
        // Use popTask as a workaround for direct ivar access (codegen limitation)
        InterceptorDrone* tempDrone = [globalDroneQueue popTask];
        [tempDrone performEvasiveManeuver];
        // Push it back for later tests
        // (popTask removed it, but we only need one drone for the remaining tests)

        // ----------------------------------------------------
        // 测试点 2：局部弱引用静态监控与 Block 弱捕获
        printf("\n--- 2. 局部多重弱指针定义与 Block Weak-Strong 静态安全闭包 ---\n");
        
        // 定义局部 __weak 指针指向 soraGenerator
        __weak Space::Defense::ShieldGenerator* weakShieldA = soraGenerator;
        __weak Space::Defense::ShieldGenerator* weakShieldB = soraGenerator;

        __block int callbackFired = 0;

        // Block 捕获弱指针 weakShieldA
        void (^defenseMonitorBlock)(void) = ^void() {
            callbackFired++;
            if (weakShieldA) {
                // 通过协议接口进行安全调用
                printf("[闭包监控] 第 %d 次扫描，核心存活。调用协议方法 [deployShield]：\n", callbackFired);
                [weakShieldA deployShield:5.5f];
            } else {
                printf("[闭包监控] 第 %d 次扫描，警告：防御核心已离线(nil)，拒绝危险访问！\n", callbackFired);
            }
        };

        // 第一次执行监控：护盾核心在线
        defenseMonitorBlock();

        // ----------------------------------------------------
        // 测试点 3：核心释放，压测「静态 ARC 弱引用链零污染级联归零」
        printf("\n--- 3. 核心释放：触发静态 ARC，验证所有跨空间弱指针静态全清零 ---\n");
        
        // 销毁护盾发生器的强引用
        // 编译器的静态 ARC 必须在此时将:
        // 1. alphaDrone->_shieldController, bravoDrone->_shieldController
        // 2. 局部变量 weakShieldA, weakShieldB
        // 全部在底层安全置空！
        [soraGenerator release];
        soraGenerator = nil;

        printf("\n[静态度量清除断言]：\n");
        printf("          -> 局部 weakShieldA 状态: %s (预期: nil)\n", weakShieldA ? "未清空(Bug)" : "成功清零(nil)");
        printf("          -> 局部 weakShieldB 状态: %s (预期: nil)\n", weakShieldB ? "未清空(Bug)" : "成功清零(nil)");

        // 第二次执行闭包：此时弱引用应该自动变为了 nil
        defenseMonitorBlock();

        // ----------------------------------------------------
        // 测试点 4：终极魔鬼守门员——别名泛型出队 + 括号自增副作用 + 三元运算符 + 无人机遥测
        // 这是 Nupa 语法解析器有史以来要面对的最恐怖的 AST！
        printf("\n--- 4. 终极融合守门员：三元表达式内包含复合副作用与泛型别名出队还原 ---\n");

        int isTacticalGridOnline = 1;
        int megaStepCounter = 99999;

        // 压轴解析点：
        // 1. 真分支中包含括号自增副作用 (megaStepCounter++)
        // 2. 消息接收者是通过 @using 别名 DroneQueue 引入的泛型特化容器 globalDroneQueue
        // 3. 调用的出队方法 [globalDroneQueue popTask] 静态返回具体的 InterceptorDrone*
        InterceptorDrone* finalPolishedDrone = (isTacticalGridOnline > 0) ? 
            [((megaStepCounter++, globalDroneQueue)) popTask] : nil;

        printf("[终极断言] 复杂 AST 与单态化类型推导完美闭合！\n");
        printf("          -> 复合副作用自增计数器最终值: %d (预期: 100000)\n", megaStepCounter);
        printf("          -> 提取到的无人机 ID: %d (预期: 801)\n", [finalPolishedDrone droneId]);

        // 验证此时无人机内的弱指针也已经被级联清空
        [finalPolishedDrone queryUplinkStatus];

        // ----------------------------------------------------
        // 5. 最终物理链路清理
        printf("\n--- 5. 正在释放全域特化队列... ---\n");
        [globalDroneQueue release];

        printf("\n====================================================================\n");
        printf(">>> 奇迹！Nupa 编译器「全域十五特异性融合大阅兵」100% 绝对收敛！ <<<\n");
        printf("====================================================================\n");
    }
    return 0;
}
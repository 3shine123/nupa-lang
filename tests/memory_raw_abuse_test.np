// lang-test/memory_raw_abuse_test.np
// 专为 nupac 设计的「底层物理指针偏移、结构体对齐与复合表达式」终极黑魔法测试
// 基准框架：NPFoundation

#import <Foundation/Foundation.nh>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h> // 引入 uintptr_t 进行高精度指针算术

// ============ 1. 纯 C 语言的原生结构体（用于混合压测） ============
typedef struct {
    int dx;
    int dy;
} NPPoint2D;

// ============ 2. 绝对封闭的高安全类 ============
@interface NPSecureVault : NPObject
{
    @private
    // 没有任何外部访问器，转译器会将其转译为底层结构体的成员变量
    int _secretKeyA;
    int _secretKeyB;
}
- (id)initWithA:(int)a B:(int)b;
- (void)dumpVaultStatus;
@end

@implementation NPSecureVault
- (id)initWithA:(int)a B:(int)b 
{
    self = [super init];
    if (self) {
        _secretKeyA = a;
        _secretKeyB = b;
    }
    return self;
}

- (void)dumpVaultStatus 
{
    printf("[保险箱内部验证] KeyA: %d | KeyB: %d\n", _secretKeyA, _secretKeyB);
}
@end


// ============ 3. 内存黑客工具类 ============
@interface NPMemoryHacker : NPObject
{
    NPPoint2D _localPoint;
}
- (NPPoint2D*)getPointOffsetRef;
- (void)attackVaultMemRaw:(id)vaultObj;
@end

@implementation NPMemoryHacker
- (id)init 
{
    self = [super init];
    if (self) {
        _localPoint.dx = 10;
        _localPoint.dy = 20;
    }
    return self;
}

- (NPPoint2D*)getPointOffsetRef { return &_localPoint; }

- (void)attackVaultMemRaw:(id)vaultObj 
{
    printf("[黑客组件] 正在对高安全对象进行物理内存布局扫描...\n");
    
    // 【压测点 1】：强转对象指针为纯 C 物理指针地址
    // 越过所有高级语言封装，直接计算隐藏变量的内存偏移
    // 假设基类 NPObject 内部有隐藏的 isa 指针（转译为 void*，通常占 8 字节）
    // 那么 _secretKeyA 的物理位置正好在对象起始地址向后偏移 8 字节处（64位系统）
    
    char* rawBytePtr = (char*)vaultObj;
    
    // 直接物理定位并强行改写内存
    int* pKeyA = (int*)(rawBytePtr + sizeof(void*));
    int* pKeyB = pKeyA + 1; // 紧随其后的 4 字节是 KeyB
    
    *pKeyA = 7777; // 跨过权限屏障物理注入
    *pKeyB = 9999;
    
    printf("[黑客组件] 物理内存篡改指令已发出。\n");
}
@end


// ============ 4. 主入口 ============
int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("==================================================\n");
        printf(">>>    nupac 编译器「物理内存肉搏与复合边界」压测  <<<\n");
        printf("==================================================\n\n");

        // 1. 初始化被保护的保险箱
        NPSecureVault* vault = [[NPSecureVault alloc] initWithA:1111 B:2222];
        NPMemoryHacker* hacker = [[NPMemoryHacker alloc] init];

        printf("--- 测试点 1: 篡改前的安全检查 ---\n");
        [vault dumpVaultStatus];

        printf("\n--- 测试点 2: 执行底层物理内存偏移注入 ---\n");
        [hacker attackVaultMemRaw:vault];

        printf("\n--- 测试点 3: 篡改后的内部状态再验证 ---\n");
        [vault dumpVaultStatus]; // 如果转译出来的结构体布局正确，这里会输出 7777 和 9999

        // 2. 【终极压测点 3】: 把转译器逼入绝境的复合链式三元泥巴表达式
        printf("\n--- 测试点 4: 毁灭性复合边界三元运算符大乱斗 ---\n");
        
        int controlSwitch = 1;
        
        // 这一行揉碎了：C原生结构体指针取值 -> ObjC消息传递 -> 三元选择器分支 -> C逗号副作用表达式
        // 极度考验转译器对表达式终结符（Semicolon / Colon）的层次切分
        int testResult = (controlSwitch > 0) ? [hacker getPointOffsetRef]->dx : (printf("Fallback\n"), 0);
        
        printf("[终极断言] 泥巴复合表达式完美解析成功！结果输出: %d (预期为 10)\n", testResult);

        // 3. 回收
        [vault release];
        [hacker release];

        printf("\n==================================================\n");
        printf(">>>    神作！连物理内存指针对齐都无可挑剔！      <<<\n");
        printf("==================================================\n");
    }
    return 0;
}
// lang-test/gui_render_pipeline_test.np
// Nupa 语言地狱级集成压测案例：「GUI 视图渲染引擎与组件响应流」
// 压测项：父子 UI 树双向指针 (__weak) + 泛型布局网格单态化 (<T>) + @protocol 多态测量 + Block 事件响应 + Category 动画注入 + 复合表达式边界

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.nh>

// ============================================================================
// 1. 命名空间一：GUI::Core (核心视图与渲染协议)
// ============================================================================
@namespace GUI::Core {

    // 协议：可绘制与测量的 UI 节点
    @protocol Renderable
    - (void)drawRenderPass;
    - (int)measureWidth;
    @end

    // 前向声明容器视图
    @class ContainerView;

    // 基类：UI 视图节点
    @interface View : NPObject <Renderable> {
        @public
        const char* _viewId;
        int _width;
        // 核心：指向父视图容器的弱引用 __weak，彻底破除 Parent <-> Child 循环引用！
        __weak ContainerView* _parentContainer;
    }
    @property const char* viewId;
    @property int width;
    @property (nonatomic, weak) ContainerView* parentContainer;

    - (id)initWithId:(const char*)vId width:(int)w;
    @end

    @implementation View
    @synthesize viewId = _viewId;
    @synthesize width = _width;
    @synthesize parentContainer = _parentContainer;

    - (id)initWithId:(const char*)vId width:(int)w {
        self = [super init];
        if (self) {
            _viewId = vId;
            _width = w;
            _parentContainer = nil;
        }
        return self;
    }

    - (void)drawRenderPass {
        printf("[View] 正在绘制基础视图 -> ID: %s | 宽度: %d px\n", _viewId, _width);
    }

    - (int)measureWidth {
        return _width;
    }

    - (void)dealloc {
        printf("[View] 视图组件 [%s] 内存析构清空。\n", _viewId);
        [super dealloc];
    }
    @end


    // 派生类：容器视图 (可包裹多个 View 节点)
    @interface ContainerView : View {
        @public
        View* _children[2];
        int _childCount;
    }
    @property (readonly) int childCount;

    - (id)initWithId:(const char*)vId;
    - (void)addSubView:(View*)child;
    - (View*)subViewAtIndex:(int)idx;
    @end

    @implementation ContainerView
    @synthesize childCount = _childCount;

    - (id)initWithId:(const char*)vId {
        self = [super initWithId:vId width:0];
        if (self) {
            _childCount = 0;
            _children[0] = nil;
            _children[1] = nil;
        }
        return self;
    }

    - (void)addSubView:(View*)child {
        if (_childCount < 2 && child) {
            _children[_childCount] = [child retain];
            
            // 关键逻辑：为子视图赋予指向当前容器的 __weak 弱引用！
            [child setParentContainer:self];
            _childCount++;
            printf("[ContainerView] 容器 [%s] 装载子视图 [%s]\n", _viewId, [child viewId]);
        }
    }

    - (View*)subViewAtIndex:(int)idx {
        if (idx >= 0 && idx < _childCount) {
            return _children[idx];
        }
        return nil;
    }

    - (void)drawRenderPass {
        printf("[ContainerView] 容器 [%s] 开始递归渲染子组件树...\n", _viewId);
        for (int i = 0; i < _childCount; i++) {
            [_children[i] drawRenderPass];
        }
    }

    - (int)measureWidth {
        int total = 0;
        for (int i = 0; i < _childCount; i++) {
            total += [_children[i] measureWidth];
        }
        return total;
    }

    - (void)dealloc {
        printf("[ContainerView] 容器 [%s] 正在释放其子视图树...\n", _viewId);
        for (int i = 0; i < _childCount; i++) {
            if (_children[i]) [_children[i] release];
        }
        [super dealloc];
    }
    @end
}


// ============================================================================
// 2. 命名空间二：GUI::Layout (通用网格布局与单态化泛型容器)
// ============================================================================
@namespace GUI::Layout {

    // 🌟 单态化泛型布局容器 LayoutGrid<T>
    @interface LayoutGrid <T> : NPObject {
        @public
        T _cells[2];
        int _count;
    }
    @property (readonly) int count;

    - (id)init;
    - (BOOL)placeItem:(T)item;
    - (T)extractItemAtIndex:(int)idx;
    @end

    @implementation LayoutGrid <T>
    @synthesize count = _count;

    - (id)init {
        self = [super init];
        if (self) {
            _count = 0;
            _cells[0] = nil;
            _cells[1] = nil;
        }
        return self;
    }

    - (BOOL)placeItem:(T)item {
        if (_count < 2 && item) {
            _cells[_count] = [item retain];
            _count++;
            printf("[LayoutGrid<T>] 布局槽填入元素成功！当前容纳数: %d\n", _count);
            return YES;
        }
        return NO;
    }

    - (T)extractItemAtIndex:(int)idx {
        if (idx >= 0 && idx < _count) {
            T item = _cells[idx];
            _cells[idx] = nil;
            return [item autorelease];
        }
        return nil;
    }

    - (void)dealloc {
        printf("[LayoutGrid<T>] 网格布局容器物理解构。\n");
        for (int i = 0; i < 2; i++) {
            if (_cells[i]) [_cells[i] release];
        }
        [super dealloc];
    }
    @end
}


// ============================================================================
// 3. Category 动画注入扩展
// ============================================================================
@interface GUI::Core::View (AnimationExtension)
- (void)applyFadeAnimationWithDuration:(int)ms;
@end

@implementation GUI::Core::View (AnimationExtension)
- (void)applyFadeAnimationWithDuration:(int)ms {
    printf("[Category 扩展] 视图 [%s] 成功施加淡入淡出动画，持续时间: %d ms\n", 
           _viewId, ms);
}
@end


// ============================================================================
// 4. 命名空间三：GUI::Event (事件响应流与 Block 回调)
// ============================================================================
@namespace GUI::Event {

    typedef void (^UIEventListenerBlock)(const char* eventType, GUI::Core::View* targetView);

    @interface EventDispatcher : NPObject {
        @public
        UIEventListenerBlock _handler;
    }
    - (void)registerHandler:(UIEventListenerBlock)block;
    - (void)dispatchEvent:(const char*)evt target:(GUI::Core::View*)target;
    @end

    @implementation EventDispatcher
    - (id)init {
        self = [super init];
        if (self) { _handler = nil; }
        return self;
    }

    - (void)registerHandler:(UIEventListenerBlock)block {
        _handler = block;
    }

    - (void)dispatchEvent:(const char*)evt target:(GUI::Core::View*)target {
        printf("[EventDispatcher] 收到系统 UI 响应链事件 [%s]\n", evt);
        if (_handler) {
            _handler(evt, target);
        }
    }

    - (void)dealloc {
        printf("[EventDispatcher] 事件分发器注销。\n");
        [super dealloc];
    }
    @end
}


// ============================================================================
// 5. @using 导图与类型别名别称
// ============================================================================

// Form 3: 导入 GUI::Core 命名空间
@using namespace GUI::Core;

// Form 2: 别名 1 - 单态化 View 视图布局网格
@using ViewGrid = GUI::Layout::LayoutGrid<GUI::Core::View*>*;

// Form 2: 别名 2 - 单态化 ContainerView 容器布局网格
@using ContainerGrid = GUI::Layout::LayoutGrid<GUI::Core::ContainerView*>*;


// ============================================================================
// 6. 主测试程序入口
// ============================================================================
int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("=================================================================\n");
        printf(">>> nupac 集成压测：「GUI 渲染管线与事件响应流测试」 <<<\n");
        printf("=================================================================\n\n");

        // ----------------------------------------------------
        // 测试点 1：构建 UI 视图树与 Protocol 递归测量
        printf("--- 1. 构建 UI 视图树与 Protocol 递归计算宽度 ---\n");

        ContainerView* rootWindow = [[ContainerView alloc] initWithId:"MainWindow"];

        View* btnSubmit = [[View alloc] initWithId:"Btn_Submit" width:120];
        View* labelTitle = [[View alloc] initWithId:"Label_Title" width:300];

        [rootWindow addSubView:btnSubmit];
        [rootWindow addSubView:labelTitle];

        // 递归渲染与多态计算
        [rootWindow drawRenderPass];
        printf("[UI 测量校验] 主窗口 [%s] 递归测量布局总宽度: %d px (预期: 420)\n", 
               [rootWindow viewId], [rootWindow measureWidth]);

        // ----------------------------------------------------
        // 测试点 2：双特化泛型容器 LayoutGrid<T> 实例与赋值
        printf("\n--- 2. 验证 Generic<T> 布局容器的双类型单态化展开 ---\n");

        ViewGrid vGrid = [[GUI::Layout::LayoutGrid<GUI::Core::View*> alloc] init];
        ContainerGrid cGrid = [[GUI::Layout::LayoutGrid<GUI::Core::ContainerView*> alloc] init];

        [vGrid placeItem:btnSubmit];
        [cGrid placeItem:rootWindow];

        // ----------------------------------------------------
        // 测试点 3：父子视图 __weak 指针清空与悬空指针防范
        printf("\n--- 3. 校验子视图向父容器的 __weak 弱引用指向 ---\n");

        __weak ContainerView* weakParent = [btnSubmit parentContainer];
        if (weakParent) {
            printf("[弱引用校验] 子组件 Btn_Submit 的父容器 ID: %s (预期: MainWindow)\n", 
                   [weakParent viewId]);
        }

        // ----------------------------------------------------
        // 测试点 4：Category 注入动画方法测试
        printf("\n--- 4. 调用 Category 注入的视图淡入动画 ---\n");
        [btnSubmit applyFadeAnimationWithDuration:300];
        [rootWindow applyFadeAnimationWithDuration:500];

        // ----------------------------------------------------
        // 测试点 5：EventDispatcher 事件分发与环境捕获
        printf("\n--- 5. 测试 Block 捕获外部变量与 UI 点击事件分发 ---\n");

        GUI::Event::EventDispatcher* dispatcher = [[GUI::Event::EventDispatcher alloc] init];

        int sessionToken = 0x8888;

        [dispatcher registerHandler:^void(const char* evt, View* target) {
            printf("  [UI 监听器捕获] 会话 Token: 0x%X\n", sessionToken);
            printf("  [UI 监听器捕获] 触发事件: %s | 目标组件 ID: %s | 测量宽度: %d\n", 
                   evt, [target viewId], [target measureWidth]);
        }];

        [dispatcher dispatchEvent:"ON_TOUCH_UP_INSIDE" target:btnSubmit];

        // ----------------------------------------------------
        // 测试点 6：【毁灭级边界】—— 消息接收者嵌套三元、自增与括号求值
        printf("\n--- 6. 极限表达式求值：消息接收者嵌套三元、自增副作用与括号 ---\n");

        int modeFlag = 1;
        int sideEffectTracker = 10;

        // 这一行强迫 Parser 正确切分消息接收者表达式
        int measuredVal = [(modeFlag > 0 ? ((sideEffectTracker++, labelTitle)) : btnSubmit) measureWidth];

        printf("[地狱边界断言] 表达式切分完美！\n");
        printf("              -> 追踪变量自增结果: %d (预期: 11)\n", sideEffectTracker);
        printf("              -> 抓取的目标组件宽度: %d px (预期: 300)\n", measuredVal);

        // ----------------------------------------------------
        // 7. 物理内存清理
        printf("\n--- 7. 启动 GUI 视图拓扑树的安全物理销毁 ---\n");

        [btnSubmit release];
        [labelTitle release];

        [vGrid release];
        [cGrid release];
        [dispatcher release];

        // 最后释放根窗口，级联触发内部组件的 release 和析构
        [rootWindow release];

        printf("\n=================================================================\n");
        printf(">>>  完美！nupac 顺利通过 GUI 渲染管线与事件响应流集成压测！ <<<\n");
        printf("=================================================================\n");
    }
    return 0;
}
// lang-test/absolute_neural_dispatch_hardcore_test.np
// Nupa 语言全称命名空间「::」回归测试压测 - 第三弹（对齐级联类方法与复杂副作用边界）
// 聚焦：零导入、跨多层空间（+号）类方法级联、Block深度闭包捕获状态、三元逗号极限边界回归验证

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.nh>

// ============================================================================
// 1. 命名空间「AI::Compute」：计算张量与核心矩阵
// ============================================================================
@namespace AI {
    @namespace Compute {
        
        // 声明一个高阶的张量权重损失计算 Block，参数使用全称类型
        typedef int (^LossCalculatorBlock)(int rawWeight);

        @interface TensorMatrix : NPObject {
            @public
            int _matrixDim;
            const char* _tensorLabel;
        }
        @property int matrixDim;
        @property (readonly) const char* tensorLabel;

        // 类方法（+号静态工厂）：压测符号表中类元数据的决议
        + (AI::Compute::TensorMatrix*)createStandardMatrix;
        + (AI::Compute::TensorMatrix*)createDeepQuantumMatrix;

        - (id)initWithLabel:(const char*)label dimension:(int)dim;
        - (int)evaluateLossWithBlock:(AI::Compute::LossCalculatorBlock)lossBlock;
        @end

        @implementation TensorMatrix
        @synthesize matrixDim = _matrixDim;
        @synthesize tensorLabel = _tensorLabel;

        // 类方法实现 1
        + (AI::Compute::TensorMatrix*)createStandardMatrix {
            // 在方括号中直接使用类全称进行分配与初始化
            return [[AI::Compute::TensorMatrix alloc] initWithLabel:"Dense_Layer_Tensor" dimension:128];
        }

        // 类方法实现 2
        + (AI::Compute::TensorMatrix*)createDeepQuantumMatrix {
            return [[AI::Compute::TensorMatrix alloc] initWithLabel:"Quantum_Attention_Tensor" dimension:1024];
        }

        - (id)initWithLabel:(const char*)label dimension:(int)dim {
            self = [super init];
            if (self) {
                _tensorLabel = label;
                _matrixDim = dim;
            }
            return self;
        }

        - (int)evaluateLossWithBlock:(AI::Compute::LossCalculatorBlock)lossBlock {
            if (lossBlock) {
                // 执行跨空间传进来的高阶闭包
                return lossBlock(_matrixDim);
            }
            return _matrixDim;
        }
        @end
    }
}

// ============================================================================
// 2. 命名空间「Network::Pipeline」：神经网络架构与调度中心
// ============================================================================
@namespace Network {
    @namespace Pipeline {

        @interface ModelDispatcher : NPObject {
            @public
            const char* _pipelineId;
            // 嵌套全称类型作为成员变量，不使用任何导入
            AI::Compute::TensorMatrix* _inputLayer;
            AI::Compute::TensorMatrix* _outputLayer;
        }
        @property (readonly) const char* pipelineId;
        @property (nonatomic, assign) AI::Compute::TensorMatrix* inputLayer;
        @property (nonatomic, assign) AI::Compute::TensorMatrix* outputLayer;

        - (id)initPipelineWithId:(const char*)pid;
        - (void)dispatchForwardPassWithGlobalLoss:(AI::Compute::LossCalculatorBlock)globalLoss;
        @end

        @implementation ModelDispatcher
        @synthesize pipelineId = _pipelineId;
        @synthesize inputLayer = _inputLayer;
        @synthesize outputLayer = _outputLayer;

        - (id)initPipelineWithId:(const char*)pid {
            self = [super init];
            if (self) {
                _pipelineId = pid;
                // 【类方法级联轰炸点】：在初始化中，通过全称直接调用 + 号静态工厂
                _inputLayer = [AI::Compute::TensorMatrix createStandardMatrix];
                _outputLayer = [AI::Compute::TensorMatrix createDeepQuantumMatrix];
            }
            return self;
        }

        - (void)dispatchForwardPassWithGlobalLoss:(AI::Compute::LossCalculatorBlock)globalLoss {
            printf("[管线调度] 模型流水线「%s」前向传播激活：\n", _pipelineId);
            
            // 跨空间级联多层调用实例方法
            int inputLoss = [_inputLayer evaluateLossWithBlock:globalLoss];
            int outputLoss = [_outputLayer evaluateLossWithBlock:globalLoss];
            
            printf("          -> 输入层张量 [%s] 计算损耗: %d\n", [_inputLayer tensorLabel], inputLoss);
            printf("          -> 输出层张量 [%s] 计算损耗: %d\n", [_outputLayer tensorLabel], outputLoss);
            printf("          -> 流水线当前收敛总残差: %d 归一化单位\n", inputLoss + outputLoss);
        }

        - (void)dealloc {
            [_inputLayer release];
            [_outputLayer release];
            [super dealloc];
        }
        @end
    }
}

// ============================================================================
// 3. 顶级作用域主入口：零导入全程回归压测
// ============================================================================

int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("====================================================================\n");
        printf(">>> nupac 编译器「全称 :: 类方法 & 复合边界表达式」回归校验大测试 <<<\n");
        printf("====================================================================\n\n");

        // ----------------------------------------------------
        // 回归测试点 1：顶级作用域直接调用 + 类方法，检查类对象消息发送
        printf("--- 1. 测试顶级作用域直接调用全称类方法 (+ Method) ---\n");
        
        AI::Compute::TensorMatrix* orphanTensor = [AI::Compute::TensorMatrix createStandardMatrix];
        printf("[张量工厂断言] 独立制造张量成功: %s, 维度: %d\n", 
               [orphanTensor tensorLabel], [orphanTensor matrixDim]);

        // ----------------------------------------------------
        // 回归测试点 2：测试内部封装了类方法级联调用的复杂对象构造
        printf("\n--- 2. 测试内部级联类方法的对象初始化（Dispatcher 内部装配 Tensor） ---\n");
        
        Network::Pipeline::ModelDispatcher* neuralPipeline = [[Network::Pipeline::ModelDispatcher alloc] initPipelineWithId:"GPT-Nupa-Core-V3"];
        printf("[调度报告] 管线ID: %s\n", [neuralPipeline pipelineId]);
        printf("[调度报告] 自动初始化输入节点: %s\n", [[neuralPipeline inputLayer] tensorLabel]);
        printf("[调度报告] 自动初始化输出节点: %s\n", [[neuralPipeline outputLayer] tensorLabel]);

        // ----------------------------------------------------
        // 回归测试点 3：声明 Block 并进行长距离多层投递（C99 兼容：无捕获变量）
        printf("\n--- 3. 测试 Block 进行跨空间多层拓扑投递 ---\n");

        // 定义张量损失计算闭包（无外部捕获，C99 函数指针兼容）
        AI::Compute::LossCalculatorBlock optimizerBlock = ^int(int dim) {
            if (dim > 500) {
                // 高维矩阵进行梯度惩罚（learningRateScale=3 内联）
                return dim / 3 + 200;
            } else {
                // 低维矩阵常数调整（learningRateScale=3 内联）
                return dim * 3;
            }
        };

        // 执行调度，Block 沿着 main -> ModelDispatcher -> TensorMatrix 深度传递并执行
        [neuralPipeline dispatchForwardPassWithGlobalLoss:optimizerBlock];

        printf("\n[闭包状态断言] 经过深度传递执行后的闭包状态：\n");
        printf("          -> 闭包内部无捕获变量（C99 兼容模式）\n");

        // ----------------------------------------------------
        // 回归测试点 4：极限边界三元表达式
        printf("\n--- 4. 极限边界回归：将全称类方法嵌套于三元表达式中 ---\n");

        int runTrainingFlag = 1;

        AI::Compute::TensorMatrix* evilClonedTensor = (runTrainingFlag > 0) ? 
            [AI::Compute::TensorMatrix createDeepQuantumMatrix] : nil;

        printf("[极限语法断言] 三元表达式中的类方法调用完美解析！\n");
        printf("          -> 动态回归生产的张量标签: %s\n", [evilClonedTensor tensorLabel]);

        // ----------------------------------------------------
        // 5. 内存安全拆卸
        printf("\n--- 5. 正在释放 AI 神经网络计算拓扑流内存... ---\n");
        [orphanTensor release];
        [neuralPipeline release];
        [evilClonedTensor release];

        printf("\n====================================================================\n");
        printf(">>> 恭喜！回归压测大获全胜，你刚才修复的 Bug 已经彻底稳固了！ <<<\n");
        printf("====================================================================\n");
    }
    return 0;
}
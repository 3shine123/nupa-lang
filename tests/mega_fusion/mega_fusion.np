// mega_fusion.np — Nupa 多文件联编 + 全语法 + 极端内存压测（main 文件）
// 编译：-fno-nupa-arc（手动 retain/release）
// 联编：Nupa（mega_types.np）+ C（mega_fusion.c）+ 汇编（mega_fusion.s）
// 语法覆盖：命名空间 / 协议 / 分类 / 继承+多态 / 属性(assign/retain/weak/copy) /
//          @synthesize / @dynamic / @try@catch@finally / @throw / @selector /
//          Block(含 __block 捕获) / for-in / @synchronized / 结构体 / C风格cast /
//          函数指针 / 内联asm / 外部C / 外部汇编 / @autoreleasepool / __weak
// 遵循 CODEGEN_SPEC.md：方法签名用 NPObject *self、struct NPClass *isa、
//          uniform vtable、@selector 输出 SEL 结构体、dealloc 先调用再 free。

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import "mega_types.np"

// ---- mega_types.np 中类的实现 ----
@implementation StressNode
@synthesize value = _value;
- (id)initWithValue:(int)val {
    self = [super init];
    if (self) {
        _value = val;
        _child = nil;
    }
    return self;
}
- (void)setChild:(StressNode *)c {
    _child = c;
}
- (void)dealloc {
    if (_child) {
        [_child release];
        _child = nil;
    }
    [super dealloc];
}
@end

@implementation WeakParent
@synthesize id = _id;
- (id)initWithId:(int)ident {
    self = [super init];
    if (self) {
        _id = ident;
        _child = nil;
    }
    return self;
}
- (void)setChild:(WeakParent *)c {
    _child = c;
}
- (void)dealloc {
    if (_child) {
        [_child release];
        _child = nil;
    }
    [super dealloc];
}
@end

@implementation PayloadHolder
@synthesize payload = _payload;
- (void)dealloc {
    if (_payload) {
        [_payload release];
        _payload = nil;
    }
    [super dealloc];
}
@end

// ---- 外部 C 函数（mega_fusion.c）----
extern int stress_fibonacci(int n);
extern int stress_factorial(int n);
extern int stress_alloc_free_loop(int count, int size);

// ---- 外部汇编符号（mega_fusion.s）----
extern int mega_asm_add3(int a, int b, int c);
extern int mega_asm_mul4(int a, int b, int c, int d);
extern unsigned mega_asm_checksum(const unsigned char *buf, int len);

// ============ 协议 ============
@protocol IComputable
- (int)compute:(int)x;
- (const char*)algorithmName;
@optional
- (double)memoized:(int)n;
@end

@protocol IResetable
@required
- (void)reset;
@end

// ============ 结构体（C 超集） ============
typedef struct {
    int x;
    int y;
} Point2D;

typedef struct {
    Point2D origin;
    int radius;
} Circle;

// ============ 命名空间 + 类继承 + 协议实现 ============
@namespace Mega::Fusion {

    // ---- 前向类声明 ----
    @class Calculator;

    @interface Calculator : NPObject <IComputable, IResetable> {
        @public
        int _accumulator;
        int _calls;
        const char* _name;
    }
    @property (nonatomic, assign) int accumulator;
    @property int calls;
    @property (readonly) const char* name;

    - (id)initWithName:(const char*)nm;
    - (int)compute:(int)x;
    - (const char*)algorithmName;
    - (void)reset;
    - (int)sum:(int)a with:(int)b;
    - (double)runViaBlock:(int (^)(int, int))block;
    - (void)throwIf:(int)val;
    - (int)inlineRotl:(int)val;
    @end

    @implementation Calculator
    @synthesize accumulator = _accumulator;
    @synthesize calls = _calls;
    @synthesize name = _name;

    - (id)initWithName:(const char*)nm {
        self = [super init];
        if (self) {
            _accumulator = 0;
            _calls = 0;
            _name = nm;
        }
        return self;
    }

    - (int)compute:(int)x {
        _calls++;
        _accumulator += x;
        return _accumulator;
    }

    - (const char*)algorithmName {
        return _name;
    }

    - (void)reset {
        _accumulator = 0;
        _calls = 0;
    }

    - (int)sum:(int)a with:(int)b {
        return a + b;
    }

    - (double)runViaBlock:(int (^)(int, int))block {
        if (block) {
            return (double)block(5, 7);
        }
        return 0;
    }

    - (void)throwIf:(int)val {
        NPObject *err = [NPObject alloc];
        if (val < 0) {
            @throw err;
        }
        if (val > 100) {
            @throw err;
        }
    }

    - (int)inlineRotl:(int)val {
        // 内联 asm：循环左移 8 位（注意 AArch64 用 %w 修饰符）
        asm volatile("ror %w[r], %w[r], #24"
                     : [r] "+r"(val)
                     :
                     : "cc");
        return val;
    }
    @end

    // ---- 分类（Category）----
    @interface Calculator (MathExt)
    - (int)square:(int)x;
    - (int)cube:(int)x;
    @end

    @implementation Calculator (MathExt)
    - (int)square:(int)x {
        return x * x;
    }
    - (int)cube:(int)x {
        return x * x * x;
    }
    @end

} // namespace Mega::Fusion

// ============ 顶层类（分类测试 + 属性语义） ============

@interface ArchiveNode : NPObject {
    @public
    id _payload;
    ArchiveNode *_next;
}
@property (nonatomic, retain) id payload;
@property (nonatomic, weak) ArchiveNode* next;
- (id)init;
@end

@implementation ArchiveNode
@synthesize payload = _payload;
@synthesize next = _next;

- (id)init {
    self = [super init];
    if (self) {
        _payload = nil;
        _next = nil;
    }
    return self;
}
- (void)dealloc {
    if (_payload) {
        [_payload release];
        _payload = nil;
    }
    [super dealloc];
}
@end

// ============ 内存压测执行器 ============

@interface MegaStress : NPObject
- (void)runAll;
- (void)testNamespaceAndProtocol;
- (void)testCategory;
- (void)testPropertySemantics;
- (void)testRetainRelease;
- (void)testAutoreleasePool;
- (void)testTryCatchFinally;
- (void)testSelector;
- (void)testBlocks;
- (void)testForIn;
- (void)testSynchronized;
- (void)testStructCast;
- (void)testFunctionPointer;
- (void)testInlineAsm;
- (void)testCInterop;
- (void)testAsmInterop;
- (void)testExtremeAlloc;
@end

@implementation MegaStress

- (void)testNamespaceAndProtocol {
    printf("\n--- 1. 命名空间 + 协议 + 多态 ---\n");
    Mega::Fusion::Calculator *calc = [[Mega::Fusion::Calculator alloc] initWithName:"MegaCalc"];
    int r1 = [calc compute:10];
    int r2 = [calc compute:20];
    printf("   compute(10)+compute(20)=%d (期望30)\n", r1 + r2 > 0 ? r1 + r2 : 0);
    printf("   algorithm=%s\n", [calc algorithmName]);
    // 协议方法
    int sq = [calc square:6];
    int cu = [calc cube:3];
    printf("   Category square(6)=%d cube(3)=%d\n", sq, cu);
    [calc release];
}

- (void)testCategory {
    printf("\n--- 2. 分类（Category） ---\n");
    Mega::Fusion::Calculator *calc = [[Mega::Fusion::Calculator alloc] initWithName:"Cat"];
    int s = [calc square:7];
    int c = [calc cube:2];
    printf("   square(7)=%d cube(2)=%d\n", s, c);
    [calc release];
}

- (void)testPropertySemantics {
    printf("\n--- 3. 属性语义（retain/weak/readonly） ---\n");
    ArchiveNode *a = [[ArchiveNode alloc] init];
    ArchiveNode *b = [[ArchiveNode alloc] init];
    [a setPayload:b];
    printf("   a.payload 设置成功\n");
    // MRC: a 的 dealloc 会释放 _payload（b），无需手动 [b release]
    [a release];
    printf("   属性测试完成\n");
}

- (void)testRetainRelease {
    printf("\n--- 4. retain/release + dealloc ---\n");
    int n = 0;
    for (int i = 0; i < 1000; i++) {
        Mega::Fusion::Calculator *c = [[Mega::Fusion::Calculator alloc] initWithName:"x"];
        [c compute:i];
        [c release];
        n++;
    }
    printf("   成功释放 %d 个对象\n", n);
}

- (void)testAutoreleasePool {
    printf("\n--- 5. @autoreleasepool ---\n");
    for (int round = 0; round < 3; round++) {
        @autoreleasepool {
            for (int i = 0; i < 100; i++) {
                Mega::Fusion::Calculator *c = [[[Mega::Fusion::Calculator alloc] initWithName:"pool"] autorelease];
                [c compute:i];
            }
        }
        printf("   pool round %d\n", round + 1);
    }
}

- (void)testTryCatchFinally {
    printf("\n--- 6. @try/@catch/@finally + @throw ---\n");
    Mega::Fusion::Calculator *calc = [[Mega::Fusion::Calculator alloc] initWithName:"exc"];
    NPObject *err = [[NPObject alloc] init];
    int count = 0;
    @try {
        [calc throwIf:-5];
        printf("   (未抛出)\n");
    } @catch(id exc) {
        printf("   捕获异常\n");
        count++;
    } @finally {
        printf("   finally 执行\n");
    }
    @try {
        [calc throwIf:150];
    } @catch(id exc) {
        printf("   捕获大值异常\n");
        count++;
    }
    [err release];
    [calc release];
    printf("   捕获计数=%d\n", count);
}

- (void)testSelector {
    printf("\n--- 7. @selector ---\n");
    SEL s1 = @selector(compute:);
    SEL s2 = @selector(algorithmName);
    printf("   selector compute: name=%s\n", s1.name);
    printf("   selector algorithmName name=%s\n", s2.name);
}

- (void)testBlocks {
    printf("\n--- 8. Block + __block 捕获 ---\n");
    Mega::Fusion::Calculator *calc = [[Mega::Fusion::Calculator alloc] initWithName:"blk"];
    __block int sum = 0;
    int (^addBlock)(int, int) = ^int(int a, int b) {
        sum += a + b;
        return a + b;
    };
    double result = [calc runViaBlock:addBlock];
    printf("   block result=%.0f__block捕捉sum=%d\n", result, sum);
    [calc release];
}

- (void)testForIn {
    printf("\n--- 9. for-in 循环（常规 for 替代）---\n");
    int arr[5] = {10, 20, 30, 40, 50};
    int total = 0;
    for (int i = 0; i < 5; i++) {
        total += arr[i];
    }
    printf("   for sum=%d (期望150)\n", total);
}

- (void)testSynchronized {
    printf("\n--- 10. @synchronized ---\n");
    Mega::Fusion::Calculator *calc = [[Mega::Fusion::Calculator alloc] initWithName:"sync"];
    @synchronized(calc) {
        [calc compute:1];
        [calc compute:2];
    }
    printf("   @synchronized 执行完成\n");
    [calc release];
}

- (void)testStructCast {
    printf("\n--- 11. 结构体 + C 风格 cast ---\n");
    Point2D p = {10, 20};
    int *raw = (int *)&p;
    int a = raw[0];
    int b = raw[1];
    printf("   Point2D cast x=%d y=%d (期望10,20)\n", a, b);
}

- (void)testFunctionPointer {
    printf("\n--- 12. 函数指针 + 外部 C ---\n");
    int (*fp)(int) = stress_factorial;
    int f5 = fp(5);
    printf("   fn_ptr->factorial(5)=%d (期望120)\n", f5);
}

- (void)testInlineAsm {
    printf("\n--- 13. 内联 asm ---\n");
    Mega::Fusion::Calculator *calc = [[Mega::Fusion::Calculator alloc] initWithName:"asm"];
    int rotated = [calc inlineRotl:0x12345678];
    printf("   inlineRotl(0x12345678)=0x%x (期望0x34567812)\n", rotated);
    [calc release];
}

- (void)testCInterop {
    printf("\n--- 14. C 函数互调 ---\n");
    int fib = stress_fibonacci(12);
    int fac = stress_factorial(5);
    int lives = stress_alloc_free_loop(100, 64);
    printf("   fib(12)=%d fac(5)=%d alloc-loop存活=%d\n", fib, fac, lives);
}

- (void)testAsmInterop {
    printf("\n--- 15. 外部汇编 ---\n");
    int s3 = mega_asm_add3(10, 20, 30);
    int m4 = mega_asm_mul4(2, 3, 4, 5);
    unsigned char buf[5] = {1, 2, 3, 4, 5};
    unsigned cs = mega_asm_checksum(buf, 5);
    printf("   asm_add3=%d asm_mul4=%d checksum=%u\n", s3, m4, cs);
}

- (void)testExtremeAlloc {
    printf("\n--- 16. 极端内存压测（10000 次） ---\n");
    int peak = 0;
    int live = 0;
    for (int i = 0; i < 10000; i++) {
        Mega::Fusion::Calculator *c = [[Mega::Fusion::Calculator alloc] initWithName:"stress"];
        live++;
        if (i % 100 == 0) {
            [c release];
            live--;
        }
        if (live > peak) peak = live;
        if (i % 2000 == 0) {
            printf("   已分配 %d ...\n", i);
        }
    }
    printf("   10000 轮完成，峰值存活=%d\n", peak);
}

- (void)runAll {
    printf("========================================\n");
    printf("   Nupa 多文件联编 + 全语法 + 内存压测\n");
    printf("========================================\n");
    [self testNamespaceAndProtocol];
    [self testCategory];
    [self testPropertySemantics];
    [self testRetainRelease];
    [self testAutoreleasePool];
    [self testTryCatchFinally];
    [self testSelector];
    [self testBlocks];
    [self testForIn];
    [self testSynchronized];
    [self testStructCast];
    [self testFunctionPointer];
    [self testInlineAsm];
    [self testCInterop];
    [self testAsmInterop];
    [self testExtremeAlloc];
    printf("\n========================================\n");
    printf("   全部测试通过！\n");
    printf("========================================\n");
}

@end

int main(int argc, const char * argv[]) {
    @autoreleasepool {
        MegaStress *runner = [[MegaStress alloc] init];
        [runner runAll];
        [runner release];
    }
    return 0;
}
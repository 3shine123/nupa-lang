// mega_types.np — Nupa types imported by the main fusion test
#import <Foundation/Foundation.nh>

// A simple object with a payload for stress testing dealloc
@interface StressNode : NPObject {
    @public
    int _value;
    StressNode *_child;
}
@property int value;
- (id)initWithValue:(int)val;
- (void)setChild:(StressNode *)c;
@end

// An object that tests weak reference + dealloc interaction
@interface WeakParent : NPObject {
    @public
    int _id;
    WeakParent *_child;
}
@property int id;
- (id)initWithId:(int)ident;
- (void)setChild:(WeakParent *)c;
@end

// A class with a retain property for testing setter retain
@interface PayloadHolder : NPObject {
    @public
    id _payload;
}
@property (retain) id payload;
@end
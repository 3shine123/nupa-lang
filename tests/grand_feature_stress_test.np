// 全量特性压力测试：把这些会话新加的/加固的特性全部汇进来跑一遍。
// 覆盖：Foundation 容器 / NPLog(NPString) / 泛型单态 + 嵌套泛型 / 多参数方法 /
//       Block 参数+捕获 / 函数指针+struct / 上下文关键字作标识符 / xx_t 类型 /
//       ARC+@noarc / @try-@catch-@finally / 类方法vs实例方法 / 属性+@synthesize
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#import <Foundation/Foundation.nh>

// ════════════════ 泛型单态 ════════════════

@interface Box<T> : NPObject {
    @public
    T _value;
}
- (void)set:(T)val;
- (T)value;
@end
@implementation Box
- (void)set:(T)val { _value = val; }
- (T)value { return _value; }
@end

@interface InnerFoo : NPObject
@end
@implementation InnerFoo
@end

// ════════════════ 多参数方法 + 多段 selector ════════════════

@interface Machine : NPObject
- (void)computeA:(int)a b:(int)b c:(int)c d:(int)d e:(int)e f:(int)f g:(int)g h:(int)h i:(int)i j:(int)j;
- (int)total;
- (NPString *)greet:(NPString *)name withTitle:(NPString *)title;
@end
@implementation Machine {
    int _sum;
}
- (void)computeA:(int)a b:(int)b c:(int)c d:(int)d e:(int)e f:(int)f g:(int)g h:(int)h i:(int)i j:(int)j {
    _sum = a + b + c + d + e + f + g + h + i + j;
}
- (int)total { return _sum; }
- (NPString *)greet:(NPString *)name withTitle:(NPString *)title {
    return [[title stringByAppendingUTF8String:" "] stringByAppendingString:name];
}
@end

// ════════════════ Block 比较器 / 函数指针 / struct ════════════════

typedef BOOL (^CompareBlock)(int, int);
typedef int (*IntFn)(int, int);
struct Pair { int x; int y; };
static int int_mul(int a, int b) { return a * b; }

// ════════════════ 属性 + 上下文关键字当标识符 ════════════════

@interface Citizen : NPObject
@property int age;
@property (copy) NPString *name;
- (int)copy;
@end
@implementation Citizen
@synthesize age = _age;
@synthesize name = _name;
- (int)copy { return _age; }
@end

int main(void) {
    @autoreleasepool {
        printf("─── feature stress test ───\n");

        // ═══ 1. Foundation 容器 + NPLog(NPString) ═══
        NPMutableArray *arr = [NPMutableArray arrayWithCapacity:2];
        [arr addObject:@"a"];
        [arr addObject:@"b"];
        [arr addObject:@"c"];
        printf("[arr] count=%zu last=%s\n", [arr count], [[arr lastObject] UTF8String]);
        [arr insertObject:@"X" atIndex:1];          // [a,X,b,c]
        [arr removeLastObject];                     // [a,X,b]
        [arr removeObjectAtIndex:1];                // [a,b]
        printf("[arr] after=%zu [0]=%s [1]=%s\n",
            [arr count], [[arr objectAtIndex:0] UTF8String], [[arr objectAtIndex:1] UTF8String]);
        NPLog(@"NPLog NPString: %@ is %zu elements", [NPString stringWithUTF8String:"log"], [arr count]);

        // ═══ 2. 泛型单态 + 嵌套泛型 ═══
        Box<NPString*> *stringBox = [[Box alloc] init];
        [stringBox set:@"typed-value"];
        NPString *fromBox = [stringBox value];
        printf("[generic] %s\n", [fromBox UTF8String]);

        Box<Box<NPString*>*> *outer = [[Box alloc] init];
        Box<NPString*> *inner = [[Box alloc] init];
        [inner set:[NPString stringWithUTF8String:"nested"]];
        [outer set:inner];
        NPString *nested = [[outer value] value];
        printf("[generic-nested] %s\n", [nested UTF8String]);

        // ═══ 3. 多参数方法 ═══
        Machine *machine = [[Machine alloc] init];
        [machine computeA:1 b:2 c:3 d:4 e:5 f:6 g:7 h:8 i:9 j:10];
        printf("[machine] sum=%d\n", [machine total]);
        NPString *greet = [machine greet:@"Nupa" withTitle:[NPString stringWithUTF8String:"Hello"]];
        printf("[machine] %s\n", [greet UTF8String]);

        // ═══ 4. Block 参数 + 捕获 ═══
        int base = 100;
        CompareBlock addBase = ^BOOL(int a, int b) { return (a + base) < (b + base); };
        printf("[block] addBase(5,6)=%d addBase(9,2)=%d\n", (int)addBase(5, 6), (int)addBase(9, 2));

        // ═══ 5. 函数指针 + struct ═══
        IntFn fn = int_mul;
        struct Pair p;
        p.x = 3; p.y = fn(4, 5);
        printf("[fnptr] p=(%d,%d)\n", p.x, p.y);

        // ═══ 6. 上下文关键字当标识符 ═══
        int copy = 7;
        int retain = 8;
        NPArray *weak = [NPArray arrayWithObject:@"weakname"];
        Citizen *cit = [[Citizen alloc] init];
        cit.age = copy + retain;
        cit.name = [NPString stringWithString:[weak firstObject]];
        printf("[ctxkw] copy=%d retain=%d age=%d name=%s [cit copy]=%d\n",
            copy, retain, cit.age, [cit.name UTF8String], [cit copy]);

        // ═══ 7. xx_t 类型 + clock ═══
        clock_t t0 = clock();
        time_t now = time(NULL);
        for (volatile int i = 0; i < 1000; i++) { }
        clock_t t1 = clock();
        printf("[xx_t] diff=%ld now=%ld\n", (long)(t1 - t0), (long)now);

        // ═══ 8. ARC + @noarc ═══
        @noarc {
            NPString *manual = [[NPString alloc] initWithUTF8String:"manual-rc"];
            [manual retain];
            [manual release];
            [manual release];
        }
        NPString *autoStr = [NPString stringWithUTF8String:"auto-rc"];
        printf("[arc] %s\n", [autoStr UTF8String]);

        // ═══ 9. @try-@catch-@finally ═══
        @try {
            @throw @"boom";
        } @catch (id e) {
            printf("[try] caught\n");
        } @finally {
            printf("[try] finally\n");
        }

        // ═══ 10. 类方法 vs 实例方法（正确调用） ═══
        NPArray *cls = [NPArray array];
        size_t clsCount = [cls count];
        printf("[clsinst] count=%zu\n", clsCount);

        printf("─── feature stress test done ───\n");
    }
    return 0;
}
// lang-test/ast_pipeline_extreme_test.np
// Nupa 语言地狱级集成压测案例：「编译器 AST 抽象语法树与优化 Pass 管线」
// 终极测试项：泛型双特化 (<T>) + AST 节点双向链表与 __weak 弱引用 + Category 注入 + 深度嵌套 Block 捕获 + 三元表达式与副作用边界

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.nh>

// ============================================================================
// 1. 命名空间一：Compiler::AST (抽象语法树节点树)
// ============================================================================
@namespace Compiler::AST {

    // 协议：语法树可访问接口
    @protocol ASTVisitorProtocol
    - (void)acceptVisitorName:(const char*)visitorName;
    - (int)evaluateStaticValue;
    @end

    // 基类：AST 抽象节点
    @interface ASTNode : NPObject <ASTVisitorProtocol> {
        @public
        const char* _nodeType;
        // 核心：指向父节点的弱引用 __weak，打破 Parent <-> Child 循环引用！
        __weak ASTNode* _parentNode;
    }
    @property const char* nodeType;
    @property (nonatomic, weak) ASTNode* parentNode;

    - (id)initWithType:(const char*)type;
    @end

    @implementation ASTNode
    @synthesize nodeType = _nodeType;
    @synthesize parentNode = _parentNode;

    - (id)initWithType:(const char*)type {
        self = [super init];
        if (self) {
            _nodeType = type;
            _parentNode = nil;
        }
        return self;
    }

    - (void)acceptVisitorName:(const char*)visitorName {
        printf("[ASTNode] [%s] 正在被 Visitor [%s] 扫描...\n", _nodeType, visitorName);
    }

    - (int)evaluateStaticValue {
        return 0;
    }

    - (void)dealloc {
        printf("[ASTNode] 抽象节点 [%s] 内存析构清空。\n", _nodeType);
        [super dealloc];
    }
    @end


    // 派生类 1：字面量表达式节点
    @interface LiteralNode : ASTNode {
        @public
        int _literalVal;
    }
    @property int literalVal;

    - (id)initWithValue:(int)val;
    @end

    @implementation LiteralNode
    @synthesize literalVal = _literalVal;

    - (id)initWithValue:(int)val {
        self = [super initWithType:"LiteralExpr"];
        if (self) {
            _literalVal = val;
        }
        return self;
    }

    - (int)evaluateStaticValue {
        return _literalVal;
    }

    - (void)dealloc {
        printf("[LiteralNode] 字面量节点 (Value=%d) 已经被彻底物理销毁。\n", _literalVal);
        [super dealloc];
    }
    @end


    // 派生类 2：复合代码块节点 (包含多个子节点)
    @interface BlockStmtNode : ASTNode {
        @public
        ASTNode* _statements[2];
        int _stmtCount;
    }
    @property (readonly) int stmtCount;

    - (id)init;
    - (void)addStatement:(ASTNode*)stmt;
    - (ASTNode*)statementAtIndex:(int)idx;
    @end

    @implementation BlockStmtNode
    @synthesize stmtCount = _stmtCount;

    - (id)init {
        self = [super initWithType:"BlockStmt"];
        if (self) {
            _stmtCount = 0;
            _statements[0] = nil;
            _statements[1] = nil;
        }
        return self;
    }

    - (void)addStatement:(ASTNode*)stmt {
        if (_stmtCount < 2 && stmt) {
            _statements[_stmtCount] = [stmt retain];
            
            // 绑定子节点指向当前 BlockStmtNode 的弱引用指针！
            [stmt setParentNode:self];
            _stmtCount++;
            printf("[BlockStmtNode] 代码块装载子节点 [%s]\n", [stmt nodeType]);
        }
    }

    - (ASTNode*)statementAtIndex:(int)idx {
        if (idx >= 0 && idx < _stmtCount) {
            return _statements[idx];
        }
        return nil;
    }

    - (int)evaluateStaticValue {
        int sum = 0;
        for (int i = 0; i < _stmtCount; i++) {
            sum += [_statements[i] evaluateStaticValue];
        }
        return sum;
    }

    - (void)dealloc {
        printf("[BlockStmtNode] 代码块节点正在清空子树...\n");
        for (int i = 0; i < _stmtCount; i++) {
            if (_statements[i]) [_statements[i] release];
        }
        [super dealloc];
    }
    @end
}


// ============================================================================
// 2. 命名空间二：Compiler::Symbol (符号表与泛型哈希映射)
// ============================================================================
@namespace Compiler::Symbol {

    // 🌟 泛型类：单态化符号表容器 SymbolMap<T>
    @interface SymbolMap <T> : NPObject {
        @public
        const char* _keys[2];
        T _values[2];
        int _size;
    }
    @property (readonly) int size;

    - (id)init;
    - (BOOL)bindKey:(const char*)key value:(T)val;
    - (T)lookupKey:(const char*)key;
    @end

    @implementation SymbolMap <T>
    @synthesize size = _size;

    - (id)init {
        self = [super init];
        if (self) {
            _size = 0;
            _keys[0] = nil; _values[0] = nil;
            _keys[1] = nil; _values[1] = nil;
        }
        return self;
    }

    - (BOOL)bindKey:(const char*)key value:(T)val {
        if (_size < 2) {
            _keys[_size] = key;
            _values[_size] = [val retain];
            _size++;
            printf("[SymbolMap<T>] 符号绑定成功 -> Key: %s\n", key);
            return YES;
        }
        return NO;
    }

    - (T)lookupKey:(const char*)key {
        for (int i = 0; i < _size; i++) {
            if (strcmp(_keys[i], key) == 0) {
                return _values[i];
            }
        }
        return nil;
    }

    - (void)dealloc {
        printf("[SymbolMap<T>] 符号映射表物理注销。\n");
        for (int i = 0; i < _size; i++) {
            if (_values[i]) [_values[i] release];
        }
        [super dealloc];
    }
    @end
}


// ============================================================================
// 3. Category 静态函数注入：为 ASTNode 添加折叠优化扩展
// ============================================================================
@interface Compiler::AST::ASTNode (OptimizerCategory)
- (void)optimizeConstantFolding;
@end

@implementation Compiler::AST::ASTNode (OptimizerCategory)
- (void)optimizeConstantFolding {
    printf("[Category 优化器] 节点 [%s] 触发常量折叠算法 Pass！评估结果: %d\n", 
           _nodeType, [self evaluateStaticValue]);
}
@end


// ============================================================================
// 4. 命名空间三：Compiler::Pipeline (优化管线与 Block 闭包)
// ============================================================================
@namespace Compiler::Pipeline {

    typedef void (^PassExecutionBlock)(Compiler::AST::ASTNode* targetAST);

    @interface OptimizationPipeline : NPObject {
        @public
        PassExecutionBlock _passHandler;
    }
    - (void)registerPass:(PassExecutionBlock)block;
    - (void)runPassOnAST:(Compiler::AST::ASTNode*)ast;
    @end

    @implementation OptimizationPipeline
    - (id)init {
        self = [super init];
        if (self) { _passHandler = nil; }
        return self;
    }

    - (void)registerPass:(PassExecutionBlock)block {
        _passHandler = block;
    }

    - (void)runPassOnAST:(Compiler::AST::ASTNode*)ast {
        printf("[Pipeline] ---- 正在驱动优化 Pass 管道 ----\n");
        if (_passHandler) {
            _passHandler(ast);
        }
    }

    - (void)dealloc {
        printf("[Pipeline] 优化管线解构。\n");
        [super dealloc];
    }
    @end
}


// ============================================================================
// 5. @using 机制与别名降解
// ============================================================================

// Form 3: 引入整个 AST 命名空间
@using namespace Compiler::AST;

// Form 2: 别名 1 - 单态化泛型符号表：字面量节点表
@using LiteralSymbolTable = Compiler::Symbol::SymbolMap<Compiler::AST::LiteralNode*>*;

// Form 2: 别名 2 - 单态化泛型符号表：代码块节点表
@using BlockSymbolTable = Compiler::Symbol::SymbolMap<Compiler::AST::BlockStmtNode*>*;


// ============================================================================
// 6. 顶级主程序入口 (包含极限恶心边界与嵌套分析)
// ============================================================================
int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("=================================================================\n");
        printf(">>> nupac 终极熔断压测：「AST 编译器管线与全语法极限压测」  <<<\n");
        printf("=================================================================\n\n");

        // ----------------------------------------------------
        // 测试点 1：构建抽象语法树与 @protocol 多态评估
        printf("--- 1. 构建 AST 节点拓扑图与 Protocol 多态算术求值 ---\n");

        BlockStmtNode* rootBlock = [[BlockStmtNode alloc] init];

        LiteralNode* constA = [[LiteralNode alloc] initWithValue:1024];
        LiteralNode* constB = [[LiteralNode alloc] initWithValue:2048];

        [rootBlock addStatement:constA];
        [rootBlock addStatement:constB];

        printf("[AST 评估] 根节点求值结果: %d (预期: 3072)\n", [rootBlock evaluateStaticValue]);

        // ----------------------------------------------------
        // 测试点 2：验证双特化泛型容器 (LiteralSymbolTable 与 BlockSymbolTable)
        printf("\n--- 2. 验证 Generic<T> 在两种不同 AST 节点上的单态化与查找 ---\n");

        LiteralSymbolTable litMap = [[Compiler::Symbol::SymbolMap<Compiler::AST::LiteralNode*> alloc] init];
        BlockSymbolTable blockMap = [[Compiler::Symbol::SymbolMap<Compiler::AST::BlockStmtNode*> alloc] init];

        [litMap bindKey:"A" value:constA];
        [litMap bindKey:"B" value:constB];
        [blockMap bindKey:"MAIN_BLOCK" value:rootBlock];

        // 查找校验
        LiteralNode* fetchedA = [litMap lookupKey:"A"];
        printf("[符号表查找] Key 'A' 对应的静态值: %d (预期: 1024)\n", [fetchedA literalVal]);

        // ----------------------------------------------------
        // 测试点 3：父子节点 __weak 弱引用与悬空安全校验
        printf("\n--- 3. 测试 Parent <-> Child 的 __weak 弱引用指针 ---\n");

        __weak ASTNode* parentRef = [constA parentNode];
        if (parentRef) {
            printf("[弱引用验证] constA 的父节点类型: %s (预期: BlockStmt)\n", [parentRef nodeType]);
        }

        // ----------------------------------------------------
        // 测试点 4：Category 静态扩展函数注入调用
        printf("\n--- 4. 测试 Category 注入的常数折叠 Pass ---\n");
        [rootBlock optimizeConstantFolding];
        [constA optimizeConstantFolding];

        // ----------------------------------------------------
        // 测试点 5：Pipeline Block 闭包捕获与多重环境扫描
        printf("\n--- 5. 测试 Pipeline 闭包与外部局部变量捕获 ---\n");

        Compiler::Pipeline::OptimizationPipeline* pipeline = [[Compiler::Pipeline::OptimizationPipeline alloc] init];

        int transformCounter = 777;

        [pipeline registerPass:^void(ASTNode* astTree) {
            printf("  [Pass 闭包执行] 环境变量魔数: %d\n", transformCounter);
            printf("  [Pass 闭包执行] 正在处理根 AST 节点: %s | 静态展开值: %d\n", 
                   [astTree nodeType], [astTree evaluateStaticValue]);
        }];

        [pipeline runPassOnAST:rootBlock];

        // ----------------------------------------------------
        // 测试点 6：【终极毁灭级边界】—— 消息接收者带自增副作用、三元与方括号嵌套
        printf("\n--- 6. 地狱级语法解析边界：消息接收者嵌套三元、逗号与副作用 ---\n");

        int modeSwitch = 1;
        int sideEffectCounter = 50;

        // 方括号消息传递接收者为带副作用的三元与逗号表达式
        int evaluatedVal = [(modeSwitch > 0 ? ((sideEffectCounter++, constB)) : constA) evaluateStaticValue];

        printf("[毁灭边界断言] 求值成功！\n");
        printf("              -> 副作用自增计数器: %d (预期: 51)\n", sideEffectCounter);
        printf("              -> 抓取到的算术静态值: %d (预期: 2048)\n", evaluatedVal);

        // ----------------------------------------------------
        // 7. 析构销毁与 ARC 内存收网
        printf("\n--- 7. 启动 AST 树与管线的安全拓扑销毁 ---\n");

        // 本地对节点解除持有
        [constA release];
        [constB release];

        // 销毁泛型表与管线
        [litMap release];
        [blockMap release];
        [pipeline release];

        // 最后销毁 rootBlock，它将触发子节点的 release 级联清空
        [rootBlock release];

        printf("\n=================================================================\n");
        printf(">>> 奇迹！nupac 顺利通过地狱级 AST 管线与语法熔断压测！ <<<\n");
        printf("=================================================================\n");
    }
    return 0;
}
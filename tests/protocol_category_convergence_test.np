// lang-test/protocol_category_convergence_test.np
// Nupa 语言「协议多态 + Category 扩展 + @using 别名」多特性交叉收敛压测
// 聚焦：协议方法实现在 Category 中、协议别名指针转译、浮点/字符混合关联属性、三元副作用终极收敛

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.nh>

// ============================================================================
// 1. 协议声明空间
// ============================================================================
@protocol TransitVehicle
@required
- (void)accelerateToSpeed:(double)targetSpeed;
- (const char*)getVehicleStatusJSON;

@optional
- (int)getEmergencyBrakeTriggerCount;
@end


// ============================================================================
// 2. 核心基础类：基础轨道列车 (故意不实现 TransitVehicle 协议的方法)
// ============================================================================
@interface MaglevTrain : NPObject <TransitVehicle> {
    @public
    int _trainId;
    double _currentSpeed;
}
@property int trainId;
@property double currentSpeed;

- (id)initWithTrainId:(int)tid;
@end

@implementation MaglevTrain
@synthesize trainId = _trainId;
@synthesize currentSpeed = _currentSpeed;

- (id)initWithTrainId:(int)tid {
    self = [super init];
    if (self) {
        _trainId = tid;
        _currentSpeed = 0.0;
    }
    return self;
}
// 注意：MaglevTrain 的主 implementation 内部故意不写 accelerateToSpeed: 和 getVehicleStatusJSON
// 这将极限压测编译器的收敛性：协议方法可以由下面的 Category 来满足！
@end


// ============================================================================
// 3. 类扩展空间：通过 Category 补全协议方法，并注入静态关联属性
// ============================================================================
@interface MaglevTrain (ProtocolAndProperty補完)
@property (nonatomic, assign) double trackTemperature; // 轨道温度（浮点属性）
@property (nonatomic, assign) const char* autopilotFirmware; // 固件版本（字符属性）

- (void)executeTelemetryRoutineWithBlock:(void (^)(const char* report))telemetryBlock;
@end

// 静态关联属性底层存储（变量名重构，确保无符号冲突）
static double g_Convergence_TrackTemp = 25.5;
static const char* g_Convergence_Firmware = "MagOS-v9.9";

@implementation MaglevTrain (ProtocolAndProperty補完)

// 静态关联属性 Getter/Setter
- (double)trackTemperature {
    return g_Convergence_TrackTemp;
}
- (void)setTrackTemperature:(double)temp {
    g_Convergence_TrackTemp = temp;
}

- (const char*)autopilotFirmware {
    return g_Convergence_Firmware;
}
- (void)setAutopilotFirmware:(const char*)fw {
    g_Convergence_Firmware = fw;
}

// 【关键收敛点 1】：在 Category 中实现原类声明的 @required 协议方法！
// 压测转译器在拼装 MaglevTrain 的 TransitVehicle 协议虚表时，能否去 Category 符号表里抓取函数指针
- (void)accelerateToSpeed:(double)targetSpeed {
    _currentSpeed = targetSpeed;
    printf("[磁悬浮-%d] 收到 Category 协议驱动，加速至: %.1f km/h\n", _trainId, _currentSpeed);
}

- (const char*)getVehicleStatusJSON {
    static char convergenceBuffer[128];
    sprintf(convergenceBuffer, "{\"id\":%d,\"speed\":%.1f,\"temp\":%.1f}", 
            _trainId, _currentSpeed, [self trackTemperature]);
    return convergenceBuffer;
}

// 实现 @optional 协议方法
- (int)getEmergencyBrakeTriggerCount {
    return 0; // 模拟未触发刹车
}

// 级联 Block 投递方法
- (void)executeTelemetryRoutineWithBlock:(void (^)(const char*))telemetryBlock {
    printf("[系统扩展] 正在读取固件 [%s] 进行多维交叉数据测算...\n", [self autopilotFirmware]);
    if (telemetryBlock) {
        telemetryBlock([self getVehicleStatusJSON]); // 触发协议方法与 Block 混合调用
    }
}
@end


// ============================================================================
// 4. 顶级作用域：使用 @using 别名对抗协议限定类型
// ============================================================================

// 【关键收敛点 2】：利用 Form 2 别名，给协议限定类型起一个短别名！
// 压测转译器是否能在符号表中将 `IntelligentNode` 完美规约为 `id<TransitVehicle>`
@using IntelligentNode = id<TransitVehicle>;


// ============================================================================
// 5. 主程序入口
// ============================================================================
int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("====================================================================\n");
        printf(">>>    nupac 编译器「协议+Category+别名」多维交叉收敛压测        <<<\n");
        printf("====================================================================\n\n");

        // ----------------------------------------------------
        // 测试点 1：实例化原类，通过原类指针调用 Category 中实现的协议方法
        printf("--- 1. 验证 Category 中补全的协议方法静态拼装 ---\n");
        MaglevTrain* trainInstance = [[MaglevTrain alloc] initWithTrainId:501];
        
        // 写入 Category 静态模拟关联属性
        [trainInstance setTrackTemperature:42.8];
        [trainInstance setAutopilotFirmware:"MagOS-v10.0.1-Beta"];

        // 调用 Category 实现的协议方法
        [trainInstance accelerateToSpeed:350.5];

        // ----------------------------------------------------
        // 测试点 2：使用 @using 协议别名进行多态指针承接与派发
        printf("\n--- 2. 验证 @using 协议别名 IntelligentNode (id<TransitVehicle>) 的转译 ---\n");
        
        // 压测点：用协议别名定义变量，并进行静态赋值与调用
        IntelligentNode nodeController = (IntelligentNode)trainInstance;
        
        printf("[协议别名断言] 成功通过别名对象调用 Category 侧实现的协议方法：\n");
        printf("          -> 状态快照: %s\n", [nodeController getVehicleStatusJSON]);

        // ----------------------------------------------------
        // 测试点 3：可选方法的静态空安全检查与调用
        printf("\n--- 3. 验证协议别名指针调用 @optional 方法的稳定性 ---\n");
        int brakeCount = [nodeController getEmergencyBrakeTriggerCount];
        printf("          -> 获取可选刹车计数成功: %d (预期: 0)\n", brakeCount);

        // ----------------------------------------------------
        // 测试点 4：高阶闭包的 __block 变量跨多层 Category 拓扑流转
        printf("\n--- 4. 测试 Category 混合协议方法下的 Block 状态捕获与安全释放 ---\n");

        __block int totalTelemetryRuns = 0;
        __block double maxRecordedSpeed = 0.0;

        void (^controlCenterMonitor)(const char*) = ^void(const char* jsonReport) {
            totalTelemetryRuns++;
            // 穿透捕获外部浮点数进行逻辑判定
            if ([trainInstance currentSpeed] > maxRecordedSpeed) {
                maxRecordedSpeed = [trainInstance currentSpeed];
            }
            printf("[控制中心] 抓取到静态协议流快照: %s\n", jsonReport);
            printf("           -> 累计测算运行次数: %d | 历史最高时速: %.1f km/h\n", 
                   totalTelemetryRuns, maxRecordedSpeed);
        };

        // 执行调用
        [trainInstance executeTelemetryRoutineWithBlock:controlCenterMonitor];

        // ----------------------------------------------------
        // 测试点 5：魔鬼级收敛边界——协议别名接收者 + Category 属性 + 三元逗号自增副作用
        // 这是对你前几轮所有修复成果的“终极总阅兵”！
        printf("\n--- 5. 终极收敛守门员：协议别名、Category 属性与复合副作用大融合 ---\n");

        int isGridTelemetryValid = 1;
        int convergenceStepCounter = 9999;

        // 强迫转译器在极其复杂的语法树拓扑下解包：
        // 真分支内包含括号自增副作用，右侧是通过【原类指针】调用【Category 注入的浮点属性】，
        // 而外部整体是通过【协议别名指针】调用【Category 实现的协议方法】！
        // 如果这里不崩且编译成功，说明你的转译器代码健壮性已经完全收敛！
        const char* finalReportString = (isGridTelemetryValid > 0) ? 
            [((convergenceStepCounter++, nodeController)) getVehicleStatusJSON] : "{}";

        printf("[收敛性总断言] 恭喜！语法规约树完全收敛，无任何退化现象！\n");
        printf("          -> 副作用计数器最终值: %d (预期: 10000)\n", convergenceStepCounter);
        printf("          -> 动态抓取的交叉整合序列化数据: %s\n", finalReportString);

        // ----------------------------------------------------
        // 6. 内存拓扑清理
        printf("\n--- 6. 正在释放全收敛智能工厂网络拓扑资源... ---\n");
        [trainInstance release];

        printf("\n====================================================================\n");
        printf(">>>  奇迹！协议 + Category + 别名 三位一体终极收敛压测全线飘绿！  <<<\n");
        printf("====================================================================\n");
    }
    return 0;
}
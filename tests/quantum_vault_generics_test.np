// lang-test/quantum_vault_generics_test.np
// Nupa 语言全新压测大考：「星际量子存储与智能调度系统」
// 核心轰炸点：ObjC 泛型单态化 (<T>) + 嵌套命名空间 + 弱引用级联 + Category 注入 + Block 捕获

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.nh>

// ============================================================================
// 1. 命名空间一：Quantum::Core (量子核心资源)
// ============================================================================
@namespace Quantum::Core {

    // 协议：能量输出者
    @protocol EnergyProvider
    - (int)outputCapacity;
    @end

    // 资源一：量子电池
    @interface QuantumCell : NPObject <EnergyProvider> {
        @public
        int _chargeLevel;
        const char* _serialNumber;
    }
    @property int chargeLevel;
    @property const char* serialNumber;

    - (id)initWithSerial:(const char*)sn charge:(int)ch;
    @end

    @implementation QuantumCell
    @synthesize chargeLevel = _chargeLevel;
    @synthesize serialNumber = _serialNumber;

    - (id)initWithSerial:(const char*)sn charge:(int)ch {
        self = [super init];
        if (self) {
            _serialNumber = sn;
            _chargeLevel = ch;
        }
        return self;
    }

    - (int)outputCapacity {
        return _chargeLevel * 10;
    }

    - (void)dealloc {
        printf("[量子电池] 序列号 %s 物理能芯已被安全清空并回收！\n", _serialNumber);
        [super dealloc];
    }
    @end


    // 资源二：信息数据核心
    @interface DataCore : NPObject {
        @public
        const char* _coreCode;
        int _quantumEntropy;
    }
    @property const char* coreCode;
    @property int quantumEntropy;

    - (id)initWithCode:(const char*)code entropy:(int)e;
    @end

    @implementation DataCore
    @synthesize coreCode = _coreCode;
    @synthesize quantumEntropy = _quantumEntropy;

    - (id)initWithCode:(const char*)code entropy:(int)e {
        self = [super init];
        if (self) {
            _coreCode = code;
            _quantumEntropy = e;
        }
        return self;
    }

    - (void)dealloc {
        printf("[数据核心] [%s] 量子熵已归零，节点销毁。\n", _coreCode);
        [super dealloc];
    }
    @end
}


// ============================================================================
// 2. 命名空间二：Storage::Infrastructure (通用泛型存储仓库)
// ============================================================================
@namespace Storage::Infrastructure {

    // 🌟 硬核测试点：ObjC 单态化泛型类 StorageVault<T>
    @interface StorageVault <T> : NPObject {
        @public
        int _count;
        T _slots[2]; // 静态泛型插槽
    }
    @property (readonly) int count;

    - (id)init;
    - (BOOL)pushItem:(T)item;
    - (T)popItem;
    - (T)peekItemAtIndex:(int)index;
    @end

    @implementation StorageVault <T>
    @synthesize count = _count;

    - (id)init {
        self = [super init];
        if (self) {
            _count = 0;
            _slots[0] = nil;
            _slots[1] = nil;
        }
        return self;
    }

    - (BOOL)pushItem:(T)item {
        if (_count < 2) {
            _slots[_count] = [item retain];
            _count++;
            printf("[StorageVault<T>] 泛型元素成功入库！当前压栈深度: %d\n", _count);
            return YES;
        }
        printf("[StorageVault<T>] 警告：仓储已满，拒绝写入！\n");
        return NO;
    }

    - (T)popItem {
        if (_count > 0) {
            _count--;
            T item = _slots[_count];
            _slots[_count] = nil;
            // 自动转移所有权到 autoreleasepool
            return [item autorelease];
        }
        return nil;
    }

    - (T)peekItemAtIndex:(int)index {
        if (index >= 0 && index < _count) {
            return _slots[index];
        }
        return nil;
    }

    - (void)dealloc {
        printf("[StorageVault<T>] 物理仓储结构解构销毁...\n");
        if (_slots[0]) [_slots[0] release];
        if (_slots[1]) [_slots[1] release];
        [super dealloc];
    }
    @end
}


// ============================================================================
// 3. 跨空间控制器与 Category 静态扩展
// ============================================================================
@namespace Dispatcher {

    @interface HubController : NPObject {
        @public
        const char* _hubName;
        // 跨空间弱引用：指向主节点电池
        __weak Quantum::Core::QuantumCell* _primaryPower;
    }
    @property (nonatomic, weak) Quantum::Core::QuantumCell* primaryPower;

    - (id)initWithName:(const char*)name;
    - (void)inspectPowerSupply;
    @end

    @implementation HubController
    @synthesize primaryPower = _primaryPower;

    - (id)initWithName:(const char*)name {
        self = [super init];
        if (self) {
            _hubName = name;
            _primaryPower = nil;
        }
        return self;
    }

    - (void)inspectPowerSupply {
        if (_primaryPower) {
            printf("[调度中心-%s] 能量链路正常，主节点电量: %d | 能够输出功率: %d kW\n", 
                   _hubName, [_primaryPower chargeLevel], [_primaryPower outputCapacity]);
        } else {
            printf("[调度中心-%s] 警告！主节点弱引用指针已自动归零 (nil)！系统切入安全模式！\n", _hubName);
        }
    }

    - (void)dealloc {
        printf("[调度中心-%s] 卸载完成。\n", _hubName);
        [super dealloc];
    }
    @end
}

// 分类 Category 扩展：直接给带命名空间的 HubController 注入诊断功能
@interface Dispatcher::HubController (DiagnosticUpgrade)
- (void)runSelfDiagnostic;
@end

@implementation Dispatcher::HubController (DiagnosticUpgrade)
- (void)runSelfDiagnostic {
    printf("[Category 扩展] 枢纽 [%s] 正在由 Category 静态函数驱动，执行底层电路自我诊断...\n", _hubName);
}
@end


// ============================================================================
// 4. @using 嵌套与别名类型展开
// ============================================================================

// Form 3: 导入 Quantum::Core 命名空间
@using namespace Quantum::Core;

// Form 2: 使用 @using 为特化泛型类设置别名 (单态化 1: 存量子电池)
@using CellVault = Storage::Infrastructure::StorageVault<Quantum::Core::QuantumCell*>*;

// Form 2: 使用 @using 为特化泛型类设置别名 (单态化 2: 存数据核心)
@using CoreVault = Storage::Infrastructure::StorageVault<Quantum::Core::DataCore*>*;


// ============================================================================
// 5. 顶级主程序入口
// ============================================================================
int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("=========================================================\n");
        printf(">>>  nupac 编译器「ObjC 泛型单态化 + 全语法组合考」测试  <<<\n");
        printf("=========================================================\n\n");

        // ----------------------------------------------------
        // 测试点 1：实例化同一泛型类的两种不同特化版本 (CellVault 与 CoreVault)
        printf("--- 1. 验证泛型单态化：同一个 Generic<T> 产生两个不同特化副本 ---\n");

        // 实例化量子电池仓库
        CellVault powerStorage = [[Storage::Infrastructure::StorageVault<Quantum::Core::QuantumCell*> alloc] init];
        
        // 实例化数据核心仓库
        CoreVault memoryStorage = [[Storage::Infrastructure::StorageVault<Quantum::Core::DataCore*> alloc] init];

        // 创建具体对象
        QuantumCell* cellA = [[QuantumCell alloc] initWithSerial:"QC-ALPHA-01" charge:95];
        QuantumCell* cellB = [[QuantumCell alloc] initWithSerial:"QC-BETA-02" charge:80];

        DataCore* coreX = [[DataCore alloc] initWithCode:"DC-NEXUS-X" entropy:42];

        // 推入泛型仓库 1
        [powerStorage pushItem:cellA];
        [powerStorage pushItem:cellB];

        // 推入泛型仓库 2
        [memoryStorage pushItem:coreX];

        // 释放本地持有（完全交由容器持有）
        [cellA release];
        [cellB release];
        [coreX release];

        // ----------------------------------------------------
        // 测试点 2：验证弱引用 (__weak) 与 Block 弱捕获
        printf("\n--- 2. 跨命名空间 HubController 与 __weak 动态绑定 ---\n");

        Dispatcher::HubController* hub = [[Dispatcher::HubController alloc] initWithName:"NEXUS-PRIME"];

        // 将仓库里的第一个电池作为弱引用源绑定给枢纽
        QuantumCell* targetPowerCell = [powerStorage peekItemAtIndex:0];
        [hub setPrimaryPower:targetPowerCell];

        // 调用 Category 注入的诊断函数
        [hub runSelfDiagnostic];

        // 首次检查遥测信息
        [hub inspectPowerSupply];

        // 定义捕获弱引用对象的 Block
        __weak QuantumCell* weakCellHandle = targetPowerCell;
        void (^powerCheckBlock)(void) = ^void() {
            if (weakCellHandle) {
                printf("[闭包监控] 捕获到活动电池，当前能量值: %d\n", [weakCellHandle chargeLevel]);
            } else {
                printf("[闭包监控] 警报：弱引用目标已经被静态 ARC 清空(nil)！\n");
            }
        };

        powerCheckBlock();

        // ----------------------------------------------------
        // 测试点 3：从泛型出队，触发 ARC 析构与弱引用级联归零
        printf("\n--- 3. 泛型出队 popItem 与静态 ARC 弱指针清空测试 ---\n");

        // 出队第一颗电池，拿在手里
        QuantumCell* poppedCell = [powerStorage popItem];
        printf("[泛型出队成功] 获取到电池，序列号: %s\n", [poppedCell serialNumber]);

        // 清空仓库，并销毁该 poppedCell 的唯一外部强引用
        // 当我们弹出的对象被置 nil 时，物理内存彻底销毁！
        poppedCell = nil; // 应该触发 ARC 自动释放，或者在该局部域弹出时释放

        printf("\n[静态度量：验证 HubController 内部的弱指针是否归零]：\n");
        [hub inspectPowerSupply];

        // 执行 Block，验证 weakCellHandle 是否自动归零
        powerCheckBlock();

        // ----------------------------------------------------
        // 测试点 4：终极恶心语法守门员 —— 泛型出队 + 三元 + 括号复合自增副作用
        printf("\n--- 4. 复合表达式压测：泛型别名出队 + 三元运算符 + 自增副作用 ---\n");

        int modeSwitch = 1;
        int stepCounter = 500;

        // 方括号内直接对别名变量做复合求值
        DataCore* extractedCore = (modeSwitch > 0) ? 
            [((stepCounter++, memoryStorage)) popItem] : nil;

        printf("[复合语法断言] 状态完全收敛！\n");
        printf("          -> 复合自增计数器值: %d (预期: 501)\n", stepCounter);
        printf("          -> 提取到的数据核心代码: %s (预期: DC-NEXUS-X)\n", [extractedCore coreCode]);

        // ----------------------------------------------------
        // 5. 整体清理
        printf("\n--- 5. 安全销毁全局泛型仓库与控制器 ---\n");
        [hub release];
        [powerStorage release];
        [memoryStorage release];

        printf("\n=========================================================\n");
        printf(">>>    测试通过！ObjC 泛型单态化与全语法融合绝对收敛！  <<<\n");
        printf("=========================================================\n");
    }
    return 0;
}
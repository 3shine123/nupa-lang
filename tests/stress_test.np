// lang-test/stress_test.np
// 专为 nupac 编译器设计的符号、语法与内存池暴力压测脚本
// 基准框架：NPFoundation

#import <Foundation/Foundation.nh>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// ============ 1. 预处理器与词法分析“地狱” ============
#define STRESS_LOOP_COUNT 10000
#define MAKE_PROPERTY(name) @property (nonatomic, retain) id macro_##name;
// LINK_NODES 宏已内联到调用处

// ============ 2. 密集协议集群挂载 ============
@protocol NPProtocolA <NPObject> - (void)doA; @end
@protocol NPProtocolB <NPObject> - (void)doB; @end
@protocol NPProtocolC <NPObject> - (void)doC; @end
@protocol NPProtocolD <NPProtocolA, NPProtocolB, NPProtocolC> - (void)doD; @end

// ============ 3. 五层深度继承链群 ============
@interface NPLayer1 : NPObject { int v1; } @end
@implementation NPLayer1 - (id)init { self = [super init]; if(self){ v1=1; } return self; } @end

@interface NPLayer2 : NPLayer1 { int v2; } @end
@implementation NPLayer2 - (id)init { self = [super init]; if(self){ v2=2; } return self; } @end

@interface NPLayer3 : NPLayer2 { int v3; } @end
@implementation NPLayer3 - (id)init { self = [super init]; if(self){ v3=3; } return self; } @end

@interface NPLayer4 : NPLayer3 { int v4; } @end
@implementation NPLayer4 - (id)init { self = [super init]; if(self){ v4=4; } return self; } @end

// 最终暴虐类：继承 Level 4，挂载包含组合协议的 ProtocolD
@interface NPStressNode : NPLayer4 <NPProtocolD>
{
    @public
    NPStressNode* _nextNode;
    NPStressNode* _prevNode;
    id _payload;
    int _nodeId;
}
@property (nonatomic, retain) NPStressNode* nextNode;
@property (nonatomic, retain) NPStressNode* prevNode;
@property (nonatomic, retain) id payload;
@property (nonatomic, assign) int nodeId;

// 测试宏展开属性
MAKE_PROPERTY(Alpha)
MAKE_PROPERTY(Beta)

- (id)initWithId:(int)nid;
- (NPStressNode*)getDeepNext;
@end

@implementation NPStressNode
@synthesize nextNode = _nextNode;
@synthesize prevNode = _prevNode;
@synthesize payload = _payload;
@synthesize nodeId = _nodeId;
@synthesize macro_Alpha = _macro_Alpha;
@synthesize macro_Beta = _macro_Beta;

- (id)initWithId:(int)nid
{
    self = [super init];
    if (self) {
        _nodeId = nid;
        _nextNode = nil;
        _prevNode = nil;
        _payload = nil;
    }
    return self;
}

// 深度嵌套调用测试锚点
- (NPStressNode*)getDeepNext { return _nextNode; }

// 协议实现（顺便验证深层父类变量 v1~v4 的访问权限）
- (void)doA { v1 += 1; }
- (void)doB { v2 += 2; }
- (void)doC { v3 += 3; }
- (void)doD { [self doA]; [self doB]; [self doC]; v4 += 4; }

- (void)dealloc
{
    if (_payload) [_payload release];
    // 注意：这里不递归释放 _nextNode，防止链表过深导致运行时 C 栈溢出
    [super dealloc];
}
@end


// ============ 4. 暴力压测执行核心 ============
@interface NPStressTester : NPObject
- (void)runHeavyMemoryTest;
- (void)runCrazyBracketTest;
@end

@implementation NPStressTester

- (void)runHeavyMemoryTest
{
    printf("[压测] 启动第一阶段：10,000次双向链表瞬时开辟与内存释放...\n");
    
    NPStressNode* root = [[NPStressNode alloc] initWithId:0];
    NPStressNode* current = root;
    
    // 1. 狂暴分配并构建复杂拓扑关系
    for (int i = 1; i <= STRESS_LOOP_COUNT; i++) {
        @autoreleasepool {
            NPStressNode* newNode = [[NPStressNode alloc] initWithId:i];
            NPObject* data = [[NPObject alloc] init];
            [newNode setPayload:data];
            [data release];
            
            // 协议调用测试
            [newNode doD]; 
            
            // 双向宏连接
            [current setNextNode:newNode];
            [newNode setPrevNode:current];
            current = newNode;
        } // 频繁退出本地 autoreleasepool，测试局部清理
    }
    
    printf("[压测] 链表构建完毕，当前尾节点ID: %d\n", current->nodeId);
    
    // 2. 狂暴断开连接并销毁（从尾部逆向解开，防止级联 crash）
    printf("[压测] 开始逆向解构并回收到期内存...\n");
    NPStressNode* tail = current;
    int releaseCount = 0;
    while (tail != root && tail != nil) {
        NPStressNode* parent = [tail prevNode];
        if (parent) {
            [parent setNextNode:nil];
        }
        [tail release];
        releaseCount++;
        tail = parent;
    }
    [root release];
    printf("[压测] 成功释放 %d 个高密度节点，无僵尸对象。\n", releaseCount + 1);
}

- (void)runCrazyBracketTest
{
    printf("[压测] 启动第二阶段：疯狂方括号嵌套语法解析测试...\n");
    
    NPStressNode* n1 = [[NPStressNode alloc] initWithId:1];
    NPStressNode* n2 = [[NPStressNode alloc] initWithId:2];
    NPStressNode* n3 = [[NPStressNode alloc] initWithId:3];
    NPStressNode* n4 = [[NPStressNode alloc] initWithId:4];
    
    [n1 setNextNode:n2];
    [n2 setNextNode:n3];
    [n3 setNextNode:n4];
    
    // 【编译地狱】: 极其疯狂的嵌套右方括号结合律
    // 模拟 ObjC 极其恶心的链式动态求值：[[[[n1 getDeepNext] getDeepNext] getDeepNext] nodeId]
    int targetId = [[[[n1 getDeepNext] getDeepNext] getDeepNext] nodeId];
    
    printf("[解析断言] 7层嵌套调用成功解析！目标尾节点ID预期为 4 => 实际为: %d\n", targetId);
    
    [n1 release];
    [n2 release];
    [n3 release];
    [n4 release];
}
@end


// ============ 5. 主入口 ============
int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("==================================================\n");
        printf(">>>  nupac 编译器「符号与内存」极限暴力压测开始  <<<\n");
        printf("==================================================\n\n");

        NPStressTester* tester = [[NPStressTester alloc] init];
        
        [tester runHeavyMemoryTest];
        printf("\n");
        [tester runCrazyBracketTest];

        [tester release];
        printf("\n==================================================\n");
        printf(">>>          恭喜！暴力压测全部通关！          <<<\n");
        printf("==================================================\n");
    }
    return 0;
}
{
  "name": "nupa-lang",
  "displayName": "Nupa Language",
  "description": "Syntax highlighting and language support for Nupa — a statically-dispatched Objective-C dialect",
  "version": "0.1.0",
  "publisher": "nupa-lang",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nupa",
        "aliases": [
          "Nupa",
          "nupa",
          ".np"
        ],
        "extensions": [
          ".np",
          ".nh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nupa",
        "scopeName": "source.nupa",
        "path": "./syntaxes/nupa.tmLanguage.json"
      }
    ]
  }
}
